---
/**
 * Header — furniture, not a feature.
 *
 * The menu button is now wired: it drives the circular-reveal panel in
 * shell/Menu.astro. The three lines morph to an X on open. The ground
 * switching (header background following the section behind it via
 * IntersectionObserver on [data-ground]) is <!-- built in ORDER.md step 1 -->.
 *
 * Fixed rules from kit/sections/00-shell.md:
 *  - 64px, sticky from 0, never hides on scroll, never shrinks
 *  - solid --ink-900 / --paper ground with a hairline bottom. NO backdrop-filter
 *  - the only thing that changes is the ground
 */
import Button from "../ui/Button.astro";
import LangSwitch from "../ui/LangSwitch.astro";
---

<header class="header" role="banner" data-ground="hero">
  <div class="header__inner">
    <a class="lockup" href="#top" aria-label="Contekai — back to top">
      {/*
        PLACEHOLDER MARK. The real logo is a client-supplied asset (CONTEXT.md
        §5): five nodes radiating from a hub, in rust. This is a stand-in drawn
        from that written description so the header composes — it is NOT the
        brand mark and must be replaced before launch. Same geometry as
        public/favicon.svg.
      */}
      <svg
        class="lockup__mark"
        width="28"
        height="28"
        viewBox="0 0 32 32"
        fill="none"
        aria-hidden="true"
        data-placeholder="awaiting client logo SVG"
      >
        <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M16 16 16 6M16 16 24.7 21M16 16 7.3 21M16 16 25.4 11.5M16 16 6.6 11.5"></path>
        </g>
        <g fill="currentColor">
          <circle cx="16" cy="16" r="3.4"></circle>
          <circle cx="16" cy="5" r="2.2"></circle>
          <circle cx="25.5" cy="10.8" r="2.2"></circle>
          <circle cx="24.9" cy="21.6" r="2.2"></circle>
          <circle cx="7.1" cy="21.6" r="2.2"></circle>
          <circle cx="6.5" cy="10.8" r="2.2"></circle>
        </g>
      </svg>
      <span class="lockup__word">Contekai</span>
    </a>

    <div class="header__actions">
      {/* Shared with the mobile menu — see ui/LangSwitch.astro. It sits inside
          header__actions, so the existing rule that fades everything except the
          menu button while the panel is open already covers it: the panel
          carries its own copy and two would be two things to read. */}
      <LangSwitch compact class="header__lang" />
      <Button variant="quiet" href="/login" class="header__login">Log in</Button>
      {/* Label must match the hero CTA and the footer CTA exactly. 00-shell.md
          names this "Start free trial" and 01-hero.md names the hero action
          "Start 7 days free"; they cannot both be right when the shell spec
          also requires them identical. The hero wins: it carries a real
          quantity, which the copy rules prefer. Kept at every width rather
          than shortened below 480px, because a label that changes at a
          breakpoint is the inconsistency the rule exists to prevent. */}


      {/* Three spans rather than a Lucide glyph, because the lines have to
          morph into an X individually. This is the one place in the build that
          draws its own icon, and it earns it: an icon swap cannot animate. */}
      <button
        type="button"
        class="menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="menu-btn__box" aria-hidden="true">
          <span class="menu-btn__line"></span>
          <span class="menu-btn__line"></span>
          <span class="menu-btn__line"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<style>
  @layer components {
    .header {
      position: sticky;
      inset-block-start: 0;
      z-index: 50;
      block-size: var(--header-h);
      /* Solid. No blur, ever — not on the dark grounds and not over the
         paper hero either, where the brief asked for backdrop-filter and its
         own avoid-list said no glassmorphism two lines earlier. Over an almost
         opaque background a 20px blur resolves to a flat fill anyway; this is
         that fill, without the compositing cost on low-end Android. */
      background-color: var(--ink-900);
      color: var(--on-ink);
      border-block-end: var(--border-ink);
      transition:
        background-color var(--dur-fast) var(--ease-out),
        color var(--dur-fast) var(--ease-out),
        border-color var(--dur-fast) var(--ease-out);
    }

    /* The header follows the section passing under it. Set by the observer in
       reveal.ts; with JS off it stays on the ink ground it ships with, which is
       correct everywhere except the first screen and never illegible. */
    .header[data-ground="hero"] {
      background-color: var(--hero-ground);
      color: var(--hero-ink);
      border-block-end-color: var(--hero-hairline);
      /* The header is a sibling of the hero, not a child, so it cannot inherit
         the hero's republished tokens — it has to carry its own. Without
         --link the quiet "Log in" stays on --kai-400 and measures 2.81:1 here. */
      --muted: var(--hero-ink-muted);
      --hairline: var(--hero-hairline);
      --link: var(--kai-600);
      --border-current: 1px solid var(--hero-hairline);
    }

    .header[data-ground="paper"] {
      background-color: var(--paper);
      color: var(--on-paper);
      border-block-end-color: var(--hairline-paper);
      --muted: var(--on-paper-muted);
      --hairline: var(--hairline-paper);
      --link: var(--kai-600);
      --border-current: var(--border-paper);
    }

    /* The mark keeps the brand orange on paper; --laterite on the ink ground is
       already verified and unchanged. */
    .header[data-ground="hero"] .lockup__mark {
      color: var(--orange-fill);
    }

    .header__inner {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      block-size: 100%;
      padding-inline: var(--gutter);
      /* Clears the till-rail gutter on desktop; --rail is 0 below 900px. */
      padding-inline-start: calc(var(--gutter) + var(--rail));
    }

    .lockup {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      min-block-size: var(--tap-min);
      margin-inline-end: auto;
      text-decoration: none;
      color: inherit;
      /* Scaling grows from the left edge and the vertical middle, which is the
         point menu.ts translates — so the two operations do not fight and the
         maths below stays one subtraction. Set unconditionally: it changes
         nothing while the transform is none. */
      transform-origin: 0 25%;
      transition: transform var(--dur-slow) var(--ease-out);
    }

    /*
      Open the menu and the lockup flies out of the header, down into the panel,
      and lands centred and larger above the nav list.

      The distances come from menu.ts, which measures the lockup against the
      empty slot the panel reserves for it and writes three custom properties.
      They have to be measured rather than computed: where that slot sits
      depends on how tall the panel's own content is, which no CSS expression
      can know. The fallbacks mean a failed script leaves the mark exactly where
      it already was rather than throwing it somewhere arbitrary.

      Transform only, so the move stays on the compositor, and it runs on
      --dur-slow — one step longer than the burger morph, so the mark arrives
      just after the X has formed rather than racing it.
    */
    :global(body:has(.menu.is-open)) .lockup {
      transform: translate(var(--brand-dx, 0px), var(--brand-dy, 0px))
        scale(var(--brand-scale, 1));
      /* The menu owns the whole screen while it is open, so the lockup stops
         being a live link back to the page behind it. menu.ts also takes it out
         of the tab order for as long as it is a brand mark rather than a link. */
      pointer-events: none;
    }

    .lockup__mark {
      color: var(--laterite);
    }

    /*
      The mark spins while the menu is open. It has to be the MARK and not the
      lockup: the lockup is already carrying the flight transform, and an
      animation and a transition on the same property on the same element fight
      — the animation wins and the flight would never happen. Separating them by
      one element costs nothing and keeps both correct.
    */
    :global(body:has(.menu.is-open)) .lockup__mark {
      animation: brand-spin var(--spin-dur) linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      :global(body:has(.menu.is-open)) .lockup__mark {
        animation: none;
      }
    }

    .lockup__word {
      font-size: 1.125rem;
      font-weight: var(--fw-bold);
      font-variation-settings: "wdth" var(--wdth-h2);
      letter-spacing: var(--track-h3);
    }

    .header__actions {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    .menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: var(--tap-min);
      block-size: var(--tap-min);
      padding: 0;
      border: 0;
      border-radius: var(--r-sm);
      background: none;
      color: inherit;
      cursor: pointer;
      position: relative;
    }

    /* The header is `position: sticky; z-index: 50`, which makes it a stacking
       context — so a z-index on the button alone can never lift it above the
       menu panel, no matter how large. The whole header has to move instead.
       While the menu is open it goes above the panel and drops its own ground,
       so the lockup and the X sit directly on the ink. */
    :global(body:has(.menu.is-open)) .header {
      z-index: 61;
      background-color: transparent;
      border-block-end-color: transparent;
      color: var(--on-ink);
    }

    /* The panel carries its own copies of these, so the header's would be
       duplicates sitting on top of them. */
    :global(body:has(.menu.is-open)) .header__actions > :not(.menu-btn) {
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-fast) var(--ease-out);
    }

    /*
      The switcher needs its own copy of that rule. Astro scopes styles to the
      file that AUTHORS the element, and LangSwitch's root div is authored in
      LangSwitch.astro — so the scoped `.header__actions > :not(.menu-btn)`
      selector above never matched it, and "EN / العربية" was rendering twice
      with the panel open: once here and once in the panel's own foot. Written
      :global so it reaches across the component boundary.
    */
    :global(body:has(.menu.is-open) .header__lang) {
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-fast) var(--ease-out);
    }

    .menu-btn__box {
      display: grid;
      gap: 5px;
      inline-size: 22px;
    }

    .menu-btn__line {
      display: block;
      block-size: 2px;
      border-radius: var(--r-full);
      background-color: currentColor;
      transform-origin: center;
      transition:
        transform var(--dur-base) var(--ease-out),
        opacity var(--dur-instant) var(--ease-out);
    }

    /* Morph to an X. The open button always sits on the panel's ink ground, so
       it takes --on-ink regardless of which section is behind the header. */
    .menu-btn.is-open {
      color: var(--on-ink);
    }

    .menu-btn.is-open .menu-btn__line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-btn.is-open .menu-btn__line:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }

    .menu-btn.is-open .menu-btn__line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Below 480 the "Log in" action moves into the deferred menu panel. */
    .header__login {
      display: none;
    }

    @media (min-width: 900px) {
      .header__login {
        display: inline-flex;
      }
    }
  }
</style>
