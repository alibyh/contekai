    /* --- meta ------------------------------------------------------------ */

    .meta {
      margin-block-start: var(--space-6);
      /* --on-ink-quiet, not --faint: 4.72:1 on --ink-800, --faint is 3.96:1
         and fails. --on-ink-quiet exists specifically for de-emphasised text
         like a copyright line that still has to clear the floor. */
      color: var(--on-ink-quiet);
      font-size: var(--fs-label);
      letter-spacing: 0.03em;
      line-height: 1.9;
      text-align: center;
    }

    /* --- desktop: the receipt expands to fill the section ------------------
       Client correction, and a real one: a receipt-shaped strip floating in
       the middle of a wide dark screen "isn't supposed to have a fixed
       width" on desktop. Below this it stays exactly the narrow, torn-edge,
       centred strip verified against footerGuide's own reference — that
       treatment is right on a phone or a tablet, where the viewport itself
       is receipt-sized. On a real desktop screen it read as a business card
       lost in a much bigger dark room, which is the same "unstructured void"
       problem Proof had, fixed the same way: give the width a considered
       composition instead of leaving one small object alone in it.

       The brand letterhead and barcode stay centred and compact — a receipt
       header doesn't need to be 1200px wide to read as one — while the
       nav/CTA/status content and the warmth panel split into the same
       left-content / right-feature two-column pattern Pricing and Proof
       already use, so the width gets used by real content rather than by
       stretching the receipt metaphor past where it holds up. */
    @media (min-width: 1024px) {
      .receipt {
        max-inline-size: var(--container);
      }

      .brand,
      .barcode {
        max-inline-size: 480px;
        margin-inline: auto;
      }

      .receipt__face {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        column-gap: var(--space-8);
        grid-template-areas:
          "brand   brand"
          "barcode barcode"
          "nav     panel"
          "cta     panel"
          "meta    meta";
      }

      .receipt__nav {
        grid-area: nav;
        display: flex;
        gap: var(--space-8);
      }

      .receipt__nav nav {
        flex: 1;
      }

      .receipt__cta {
        grid-area: cta;
      }

      .panel {
        grid-area: panel;
        /* Spans the nav+cta rows; centred within that combined height rather
           than pinned to the top of it. */
        align-self: center;
        margin-block-start: 0;
      }

      .meta {
        grid-area: meta;
        margin-block-start: var(--space-8);
      }
    }

    /* --- the closing rail --------------------------------------------------- */

    .footer__rail {
      block-size: 2px;
      background-color: var(--laterite);
    }

    /* --- motion -------------------------------------------------------------
       The whole receipt clips in from the top once, like the pricing receipt
       being printed — the shared [data-reveal="print"]-style behaviour, but
       kept local because the observed element must never be the clipped one
       (see the note in motion.css after the pricing bug). Nothing else in the
       footer animates: the socials/WhatsApp hover is colour-only, not a lift,
       and the status dot does not pulse. */

    .receipt[data-reveal] {
      opacity: 1;
      transform: none;
    }

    .receipt__face {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transition:
        opacity var(--dur-slow) var(--ease-out),
        clip-path var(--dur-slow) var(--ease-out);
    }

    .receipt.is-in .receipt__face {
      opacity: 1;
      clip-path: inset(0);
    }

    :global(html:not([data-js])) .receipt__face {
      opacity: 1;
      clip-path: none;
    }
  }
