    /* The brief's OTHER fallback trigger, and the one that actually fires in
       practice: "test at 320px — if the clip eats the WhatsApp button or the
       hours line, reduce lobe depth or fall back to the rounded rectangle."
       Measured, not assumed: at 375px the panel box comes out 271x338 —
       narrower than it is tall — and objectBoundingBox stretches the same
       five-lobe path non-uniformly onto that aspect ratio, so a valley lands
       close to horizontal and pinches the middle. The awaiting-state box and
       "We're friendlier..." both clipped in a real screenshot. Below the
       width the shape needs to breathe, it becomes the rounded rectangle —
       same fallback as the @supports block above, triggered by geometry
       instead of by feature support. */
    @media (max-width: 479.98px) {
      .panel__shape {
        clip-path: none;
        border-radius: var(--r-md);
      }
    }

    .panel__watermark {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      inline-size: 120px;
