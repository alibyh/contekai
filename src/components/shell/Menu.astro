---
/**
 * Menu — the circular-reveal panel behind the header's menu button.
 *
 * Ported from the client's `menu_mobile/` React component to Astro + vanilla
 * TS, because this project ships no framework runtime. The behaviour is the
 * same: a bubble scales out of the button's corner, the burger morphs to an X,
 * and the items cascade in. What changed, and why:
 *
 *  - `bubbleGradient` is now a solid `--ink-900`. The design system permits
 *    exactly one gradient in the whole build (the footer panel), and a
 *    full-screen radial gradient would be a second. The circular reveal is the
 *    idea; the gradient was decoration. One line to put back if wanted.
 *  - `filter: blur()` on the cascading items is dropped. Blur on a full-screen
 *    overlay is expensive on the low-end Android this audience uses, and the
 *    fade plus rise already carries the cascade.
 *  - Timings come from the motion tokens rather than the component's own
 *    numbers, so the menu moves like the rest of the page.
 *  - Colours, type and spacing are tokens throughout; nothing is hardcoded.
 *
 * Kept from the original: the circular reveal, the burger morph, the cascade,
 * Escape to close, scroll lock, and the reduced-motion path.
 *
 * Added, because a real menu needs them: focus is moved into the panel on open
 * and returned to the button on close, focus is trapped while open, the panel
 * is `inert` when closed so nothing inside is tabbable, and every item is a
 * real anchor to a real section rather than a button with a handler.
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import Button from "../ui/Button.astro";

/**
 * The client's own brand SVGs, read off disk at build time so the source of
 * truth stays the actual files rather than a paste. Same helper as Footer.astro
 * — resolved from process.cwd() rather than import.meta.url, because Vite
 * rewrites where the compiled module lives and a relative climb lands in the
 * wrong tree at build time.
 */
function brandIcon(name: string): string {
  const path = join(process.cwd(), "iconsSvg", `${name}.svg`);
  const raw = readFileSync(path, "utf8");
  return raw.replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>[\s\S]*$/, "");
}

const IG_ICON = brandIcon("instagram");
const TIKTOK_ICON = brandIcon("tiktok");

const links = [
  { href: "#what-it-does", label: "What it does" },
  { href: "#built-for-here", label: "Built for here" },
  { href: "#pricing", label: "Pricing" },
  { href: "#shops", label: "Shops using it" },
];
---

<div class="menu" id="site-menu" data-menu inert>
  {/* Scales out of the button's corner. Solid ink, not a gradient. */}
  <div class="menu__bubble" aria-hidden="true"></div>

  {/*
    One navigation landmark around everything, not just the section links.
    axe flagged the actions, the language switcher and the socials as content
    outside any landmark — the actions had been sitting outside one since the
    port and it only surfaced now that there is more of it. A site menu holding
    links, a call to action, a language choice and social links is exactly what
    a <nav> is for, so the panel is the landmark and the inner one is gone
    rather than nested.
  */}
  <nav class="menu__content" aria-label="Menu">
    <ul class="menu__list">
      {
        links.map((link, i) => (
          <li class="menu__item" style={`--i:${i}`}>
            <a class="menu__link" href={link.href} data-menu-link>
              <span>{link.label}</span>
              <span class="menu__index t-mono" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="menu__actions menu__item" style={`--i:${links.length}`}>
      <Button variant="primary" href="/signup" data-menu-link>
        Start 7 days free
      </Button>
      <Button variant="quiet" href="/login" data-menu-link>Log in</Button>
    </div>

    <div class="menu__foot menu__item" style={`--i:${links.length + 1}`}>
      {/*
        Language switcher. No background of any kind, per the request — it is
        two words and a divider, which is all a two-language switcher needs.

        Arabic is present and NOT pretending to work: there are no translations
        yet, so the option carries aria-disabled and a data-todo rather than
        silently doing nothing when pressed. It still reads as the inactive half
        of a switcher, which is exactly what it is. Drop aria-disabled and wire
        an href the day the Arabic route exists.

        The Arabic label carries lang and dir so it is announced in the right
        voice and shaped right-to-left. It also falls outside Archivo's subset,
        so it renders in the system Arabic face — correct, and free.
      */}
      <div class="lang" role="group" aria-label="Language">
        <span class="lang__opt lang__opt--on" aria-current="true">EN</span>
        <span class="lang__sep" aria-hidden="true">/</span>
        <button
          type="button"
          class="lang__opt"
          lang="ar"
          dir="rtl"
          aria-disabled="true"
          aria-label="Arabic — translation not available yet"
          data-todo="awaiting Arabic translation"
        >
          العربية
        </button>
      </div>

      {/* Same accounts, same treatment as the footer. One source of truth for
          where Contekai actually is; LinkedIn stays an honest placeholder. */}
      <ul class="socials" role="list">
        <li>
          <a
            class="social"
            href="https://www.instagram.com/p/DbkUhxTCdcL/"
            target="_blank"
            rel="noopener"
            aria-label="Contekai on Instagram"
            data-menu-link
          >
            <svg viewBox="0 0 48 48" aria-hidden="true" set:html={IG_ICON} />
          </a>
        </li>
        <li>
          <a
            class="social"
            href="https://www.tiktok.com/@contekai_"
            target="_blank"
            rel="noopener"
            aria-label="Contekai on TikTok"
            data-menu-link
          >
            <svg viewBox="0 0 48 48" aria-hidden="true" set:html={TIKTOK_ICON} />
          </a>
        </li>
        <li>
          <button
            type="button"
            class="social"
            aria-label="LinkedIn — account not yet confirmed"
            data-todo="awaiting client handle"
          >
            <svg viewBox="0 0 48 48" aria-hidden="true">
              <rect width="48" height="48" rx="9" fill="#0a66c2"></rect>
              <path
                fill="#fff"
                d="M14.6 20.2h5.4V35h-5.4V20.2zM17.3 18a3.1 3.1 0 1 1 0-6.2 3.1 3.1 0 0 1 0 6.2zM23.4 20.2h5.2v2.1h.07c.72-1.36 2.49-2.8 5.13-2.8 5.49 0 6.5 3.6 6.5 8.3V35h-5.4v-6.6c0-1.57-.03-3.6-2.2-3.6-2.2 0-2.53 1.72-2.53 3.5V35h-5.4V20.2z"
              ></path>
            </svg>
          </button>
        </li>
      </ul>
    </div>
  </nav>
</div>

<style>
  @layer components {
    .menu {
      position: fixed;
      inset: 0;
      /* Above the header (50), below nothing else. */
      z-index: 60;
      overflow: hidden;
      pointer-events: none;
    }

    .menu[inert] {
      /* Belt and braces with the inert attribute: nothing inside can be
         reached by pointer or tab when the menu is shut. */
      pointer-events: none;
    }

    .menu.is-open {
      pointer-events: auto;
    }

    /* --- the bubble ---------------------------------------------------------
       A circle far larger than any viewport, anchored so its edge sits at the
       menu button's corner, scaled from 0. Only transform animates. */

    .menu__bubble {
      position: absolute;
      /* Anchored to the button's corner: header is 64px tall, the button sits
         at the inline end inside the gutter. */
      inset-block-start: calc(32px - 150vmax);
      inset-inline-end: calc(var(--gutter) + 22px - 150vmax);
      inline-size: 300vmax;
      block-size: 300vmax;
      border-radius: var(--r-full);
      background-color: var(--ink-900);
      transform: scale(0);
      transition: transform var(--dur-stage) cubic-bezier(0.86, 0, 0.07, 1);
      will-change: transform;
    }

    .menu.is-open .menu__bubble {
      transform: scale(1);
    }

    /* --- content ------------------------------------------------------------ */

    .menu__content {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-8);
      padding: calc(var(--header-h) + var(--space-8)) var(--gutter) var(--space-8);
      overflow-y: auto;
      opacity: 0;
      transition: opacity var(--dur-base) var(--ease-out);
    }

    .menu.is-open .menu__content {
      opacity: 1;
      transition: opacity var(--dur-slow) var(--ease-out) 160ms;
    }

    .menu__list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    /* The cascade. Fade and rise only — no blur: it is expensive full-screen on
       a low-end phone and the movement already reads. */
    .menu__item {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity var(--dur-slow) var(--ease-out),
        transform var(--dur-slow) var(--ease-out);
      /* Closing runs much faster and nearly together, so the items are gone
         before the bubble collapses over them. */
      transition-delay: calc(var(--i) * 20ms);
    }

    .menu.is-open .menu__item {
      opacity: 1;
      transform: none;
      transition-delay: calc(220ms + var(--i) * var(--stagger));
    }

    .menu__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      min-block-size: var(--tap-min);
      padding-block: var(--space-4);
      border-block-end: var(--border-ink);
      color: var(--on-ink);
      font-size: clamp(1.5rem, 6vw, 2rem);
      font-weight: var(--fw-semibold);
      font-variation-settings: "wdth" var(--wdth-h2);
      letter-spacing: var(--track-h3);
      text-decoration: none;
      transition: padding-inline-start var(--dur-fast) var(--ease-out);
    }

    .menu__link:hover {
      padding-inline-start: var(--space-2);
    }

    .menu__index {
      color: var(--on-ink-quiet);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
    }

    .menu__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
    }

    /* --- the foot: language + socials --------------------------------------- */

    /*
      The auto top margin absorbs the free space the column's centring would
      otherwise spread around, which pins the foot to the bottom while the nav
      and the actions stay optically centred above it.
    */
    .menu__foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
      margin-block-start: auto;
      padding-block-start: var(--space-5);
      border-block-start: var(--border-ink);
    }

    .lang {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    /* No background, no border, no chip. Text and a divider. */
    .lang__opt {
      min-block-size: var(--tap-min);
      display: inline-flex;
      align-items: center;
      padding: 0;
      border: 0;
      background: none;
      color: var(--on-ink-muted);
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      line-height: var(--lh-flat);
      text-transform: uppercase;
      cursor: pointer;
    }

    /* The current language is the one that is not muted. Weight and value carry
       it, so it is never colour alone. */
    .lang__opt--on {
      color: var(--on-ink);
      cursor: default;
    }

    /* Arabic is not uppercase-able and should not be letterspaced — neither
       does anything useful to an Arabic face, and tracking actively breaks the
       joins between letters. */
    .lang__opt[lang="ar"] {
      font-family: var(--font-sans);
      font-size: var(--fs-small);
      letter-spacing: normal;
      text-transform: none;
    }

    .lang__sep {
      color: var(--on-ink-faint);
      font-family: var(--font-mono);
      font-size: var(--fs-label);
    }

    .socials {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* Same treatment as the footer's: these are full-colour third-party badges
       (an Instagram gradient, TikTok's own near-black square) and they need a
       light backer to read at all on --ink-900. */
    .social {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: var(--tap-min);
      block-size: var(--tap-min);
      padding: 0;
      border: 0;
      border-radius: var(--r-full);
      background-color: rgb(255 255 255 / 0.94);
      color: inherit;
      text-decoration: none;
      cursor: pointer;
      transition: transform var(--dur-fast) var(--ease-out);
    }

    .social:hover {
      transform: translateY(-1px);
    }

    .social svg {
      inline-size: 24px;
      block-size: 24px;
    }

    /* --- reduced motion ------------------------------------------------------
       The global block already collapses durations and delays. The bubble is
       the one thing that must not merely be fast — a full-screen circle
       snapping open is worse than no animation, so it is replaced outright by
       the panel simply being there. */
    @media (prefers-reduced-motion: reduce) {
      .menu__bubble {
        transform: scale(1);
        opacity: 0;
      }

      .menu.is-open .menu__bubble {
        opacity: 1;
      }
    }
  }
</style>
