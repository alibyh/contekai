---
/**
 * 02 — Capabilities. The card deck. Paper ground: the first light after the
 * hero's night.
 *
 * The rule that stops this collapsing into a feature grid: every card carries a
 * fragment of the real product. The icon is small and secondary; the evidence
 * is the subject. If a card would still make sense with its fragment removed,
 * the fragment is not doing work.
 *
 * FRAGMENTS — read before changing them.
 * The section spec asks for cropped 2x screenshots. Those are a client asset
 * that has not landed (CONTEXT.md §5), so the fragments here are built in
 * markup instead of imaged. That is deliberate rather than a stopgap:
 *   - they are drawn from the real product vocabulary CONTEXT.md §4 records —
 *     the sidebar, the payment methods (Cash / Mobile Money / Bank Transfer),
 *     GMD totals, per-location billing, the offline/synced state
 *   - rendered in this design system they read as specimens of the product,
 *     not as photographs of it, which is more honest than a soft screenshot
 *   - they cost no bandwidth, stay sharp on any screen, and reflow at 320px
 *
 * Where a fragment needs row-level data that CONTEXT.md does not record (stock
 * quantities, hour-by-hour sales), the values are ILLUSTRATIVE and marked
 * data-illustrative in the markup. GMD 1,580.00 is the one real figure and it
 * comes from the Transactions screen in CONTEXT.md §4. Nothing here is a claim
 * about the business. Replace with real 2x screenshots when they arrive.
 */
import Eyebrow from "../ui/Eyebrow.astro";
import Icon from "../ui/Icon.astro";

interface Card {
  index: string;
  title: string;
  body: string;
  icon: string;
  tag: string;
  fragment: "pos" | "stock" | "profit" | "branches" | "trends" | "offline";
}

/** Facts from CONTEXT.md §4. Titles name an action, never a category. */
const cards: Card[] = [
  {
    index: "01",
    title: "Ring up a sale in seconds",
    body: "Scan the barcode, take cash, Wave, or bank transfer, print the receipt. Done.",
    icon: "scan-barcode",
    tag: "Barcode · Receipts",
    fragment: "pos",
  },
  {
    index: "02",
    title: "Know what's running out",
    body: "Live stock counts, low-stock alerts, expiry dates, and a reorder list that writes itself.",
    icon: "package-search",
    tag: "Alerts · Expiry",
    fragment: "stock",
  },
  {
    index: "03",
    title: "See the day's profit",
    body: "Sales, expenses, and profit in dalasis. Today, this week, this month.",
    icon: "receipt",
    tag: "Dalasis · Reports",
    fragment: "profit",
  },
  {
    index: "04",
    title: "Run every branch from one place",
    body: "Add locations, give staff their own logins and permissions, see who sold what.",
    icon: "building-2",
    tag: "Branches · Staff",
    fragment: "branches",
  },
  {
    index: "05",
    title: "Find your best sellers",
    body: "Top products, busiest hours, margins per item. The numbers you'd otherwise guess at.",
    icon: "trending-up",
    tag: "Trends · Margins",
    fragment: "trends",
  },
  {
    /* The thesis card. Last, so the deck closes on the differentiator.
       It used to be the one dark card in a paper deck; now every card is dark,
       so it no longer stands apart visually — see NOTES.md. */
    index: "06",
    title: "Keep going when the network doesn't",
    body: "Sales and stock updates carry on offline. Everything syncs the moment you're back.",
    icon: "wifi-off",
    tag: "Offline · Sync",
    fragment: "offline",
  },
];
---

<section
  class="cap"
  id="what-it-does"
  data-section="capabilities"
  data-ground="paper"
  aria-labelledby="cap-title"
>
  <div class="cap__head">
    <div class="cap__headings">
      <Eyebrow index="02">What it does</Eyebrow>
      <h2 id="cap-title">From the counter to the books.</h2>
    </div>

    {/* Controls sit right, on the heading's baseline. A centred header over a
        horizontal deck is the template shape; this asymmetry is the point. */}
    <div class="cap__controls">
      <button
        type="button"
        class="cap__arrow"
        data-deck-prev
        aria-label="Previous capability"
      >
        <Icon name="arrow-left" size={20} />
      </button>
      <button
        type="button"
        class="cap__arrow"
        data-deck-next
        aria-label="Next capability"
      >
        <Icon name="arrow-right" size={20} />
      </button>
      <p class="cap__count t-mono" data-deck-count aria-live="polite">
        01 / 06
      </p>
    </div>
  </div>

  <div
    class="cap__stage"
    data-deck-track
    tabindex="0"
    role="group"
    aria-label="Capabilities"
  >
    {
      cards.map((card) => (
        <article class="card" data-deck-card>
          <p class="card__index t-mono" aria-hidden="true">
            {card.index}
          </p>

          <div class="card__fragment">
            {card.fragment === "pos" && (
              <div class="frag frag--rows">
                <p class="frag__label t-mono">Sale · POS</p>
                <ul class="frag__list">
                  <li data-illustrative>
                    <span>Item scanned</span>
                    <span class="t-figure">D 500.00</span>
                  </li>
                  <li data-illustrative>
                    <span>Item scanned</span>
                    <span class="t-figure">D 1,080.00</span>
                  </li>
                </ul>
                <p class="frag__total">
                  <span class="t-mono">Total</span>
                  <span class="t-figure frag__total-value">GMD 1,580.00</span>
                </p>
                <p class="frag__note t-mono">Cash · Mobile Money · Bank transfer</p>
              </div>
            )}

            {card.fragment === "stock" && (
              <div class="frag frag--rows">
                <p class="frag__label t-mono">Stock · alerts</p>
                <ul class="frag__list frag__list--stock">
                  <li data-illustrative>
                    <span>Below reorder level</span>
                    <span class="frag__state frag__state--low t-mono">
                      3 left
                    </span>
                  </li>
                  <li data-illustrative>
                    <span>Expires in 6 days</span>
                    <span class="frag__state frag__state--low t-mono">
                      Expiring
                    </span>
                  </li>
                  <li data-illustrative>
                    <span>Count matches</span>
                    <span class="frag__state frag__state--ok t-mono">
                      <Icon name="check" size={14} />
                      In stock
                    </span>
                  </li>
                </ul>
                <p class="frag__note t-mono">Reorder list updated</p>
              </div>
            )}

            {card.fragment === "profit" && (
              <div class="frag frag--figure">
                <p class="frag__label t-mono">Total sales · today</p>
                {/* The one real figure on the page, from the Transactions
                    screen recorded in CONTEXT.md §4. */}
                <p class="frag__big t-figure">GMD 1,580.00</p>
                <dl class="frag__pair">
                  <div>
                    <dt class="t-mono">Expenses</dt>
                    <dd class="t-figure" data-illustrative>
                      D 410.00
                    </dd>
                  </div>
                  <div>
                    <dt class="t-mono">Profit</dt>
                    <dd class="t-figure" data-illustrative>
                      D 1,170.00
                    </dd>
                  </div>
                </dl>
              </div>
            )}

            {card.fragment === "branches" && (
              <div class="frag frag--rows">
                <p class="frag__label t-mono">Locations · staff</p>
                <ul class="frag__list">
                  <li data-illustrative>
                    <span>Serekunda</span>
                    <span class="frag__role t-mono">Manager</span>
                  </li>
                  <li data-illustrative>
                    <span>Banjul</span>
                    <span class="frag__role t-mono">Cashier</span>
                  </li>
                  <li data-illustrative>
                    <span>Brikama</span>
                    <span class="frag__role t-mono">Cashier</span>
                  </li>
                </ul>
                <p class="frag__note t-mono">Per-location billing</p>
              </div>
            )}

            {card.fragment === "trends" && (
              <div class="frag frag--chart">
                <p class="frag__label t-mono">Sales by hour</p>
                {/* Shape only. Bar heights are illustrative, not measured. */}
                <ul class="frag__bars" data-illustrative aria-hidden="true">
                  <li style="--h: 22%"></li>
                  <li style="--h: 38%"></li>
                  <li style="--h: 54%"></li>
                  <li style="--h: 92%"></li>
                  <li style="--h: 71%"></li>
                  <li style="--h: 45%"></li>
                  <li style="--h: 63%"></li>
                  <li style="--h: 34%"></li>
                </ul>
                <p class="frag__axis t-mono">
                  <span>8am</span>
                  <span>Busiest 1pm</span>
                  <span>8pm</span>
                </p>
              </div>
            )}

            {card.fragment === "offline" && (
              <div class="frag frag--offline">
                <p class="frag__label t-mono">Connection</p>
                <p class="frag__status frag__status--off t-mono">
                  <Icon name="wifi-off" size={16} />
                  Offline · still selling
                </p>
                <ul class="frag__list frag__list--queue">
                  <li data-illustrative>
                    <span>Sale recorded</span>
                    <span class="t-mono">Queued</span>
                  </li>
                  <li data-illustrative>
                    <span>Stock updated</span>
                    <span class="t-mono">Queued</span>
                  </li>
                </ul>
                {/* --signal is state only, and never colour alone: the word
                    "Synced" and the tick carry it too. */}
                <p class="frag__status frag__status--ok t-mono">
                  <Icon name="check" size={16} />
                  Synced when back online
                </p>
              </div>
            )}
          </div>

          <h3 class="card__title">{card.title}</h3>
          <p class="card__body">{card.body}</p>

          <p class="card__tag t-mono">
            <Icon name={card.icon} size={20} class="card__icon" />
            {card.tag}
          </p>
        </article>
      ))
    }
  </div>

  {/* Six segments, one per card. Pointer-interactive (click or drag to jump)
      and aria-hidden: the arrows, the keyboard and the live counter already
      carry navigation and position, so this duplicates nothing unique. */}
  <div class="cap__scrub" data-deck-scrub aria-hidden="true">
    {cards.map(() => <span class="cap__seg" data-deck-seg />)}
  </div>
</section>

<script>
  import "../../scripts/deck.ts";
</script>

<style>
  @layer sections {
    /* Padding comes from the single [data-section] rule in base.css.
       This section sets its own inline padding to zero on the right so the
       track can bleed; the head keeps the gutter. */
    .cap {
      padding-inline: 0;
      display: grid;
      gap: var(--space-6);
    }

    /* --- header ------------------------------------------------------------ */

    .cap__head {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-5);
      padding-inline: var(--gutter);
    }

    .cap__headings {
      display: grid;
      gap: var(--space-4);
      max-inline-size: 42rem;
    }

    /* Constrained on the H2 itself. A ch cap on the block above measured
       against the 12px mono eyebrow instead and folded the heading into five
       lines. 20ch is narrower than the full string, so balance splits it in
       two even lines. */
    .cap__headings h2 {
      max-inline-size: 20ch;
    }

    .cap__controls {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    .cap__arrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: var(--tap-min);
      block-size: var(--tap-min);
      padding: 0;
      border: var(--border-current);
      border-radius: var(--r-sm);
      background: none;
      color: inherit;
      cursor: pointer;
      transition:
        border-color var(--dur-fast) var(--ease-out),
        opacity var(--dur-fast) var(--ease-out);
    }

    .cap__arrow:hover {
      border-color: currentColor;
    }

    /* Disabled at the ends, never hidden: a control that disappears makes the
       layout jump. aria-disabled rather than disabled, so it stays focusable
       and its label is still announced. */
    .cap__arrow[aria-disabled="true"] {
      opacity: 0.35;
      cursor: default;
    }

    .cap__count {
      margin-inline-start: var(--space-3);
      color: var(--muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      font-variant-numeric: tabular-nums;
    }

    /* --- stage -------------------------------------------------------------
       DEFAULT (and the JS-off state): a plain horizontally scrolling snap row
       showing all six cards. The stacked layout below only exists once deck.ts
       has set [data-stacked], so nothing here depends on JS to be usable.
       ---------------------------------------------------------------------- */

    .cap__stage {
      display: flex;
      gap: var(--space-5);
      /* Pinned in both states. In the pre-JS flex row the height is otherwise
         content-driven, which leaves it exposed to a reflow when the web font
         swaps — one Lighthouse run out of four attributed a 0.608 CLS to
         exactly that, on this element. Fixing the height removes the whole
         class of shift rather than chasing the flake. */
      min-block-size: 500px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline-start: var(--gutter);
      padding-inline: var(--gutter) var(--space-7);
      touch-action: pan-x pan-y;
      scrollbar-width: none;
    }

    .cap__stage::-webkit-scrollbar {
      display: none;
    }

    .cap__stage:focus-visible {
      outline: var(--focus-ring);
      outline-offset: -3px;
    }

    /* --- stage, stacked ------------------------------------------------------
       Three-up: the active card centred and full size, previous and next
       peeking from either side, BEHIND it. Depth comes from scale, opacity and
       z-order only — no shadow tricks, no perspective, no rotateY. Adding any
       of those turns this into coverflow, which is the exact templated shape
       the section is trying to avoid.

       The three cards that are not in play stay in the DOM at opacity 0 and are
       hidden from assistive tech by deck.ts, so nothing off-stage can take
       focus or be read out of order.
       ---------------------------------------------------------------------- */

    .cap__stage[data-stacked] {
      display: block;
      position: relative;
      block-size: 500px;
      min-block-size: 500px;
      overflow: clip;
      padding-inline: 0;
      scroll-snap-type: none;
      overflow-x: clip;
    }

    .cap__stage[data-stacked] .card {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 50%;
      margin-inline-start: calc(var(--card-w) / -2);
      opacity: 0;
      transform: scale(0.88);
      pointer-events: none;
      transition:
        transform var(--dur-slow) var(--ease-out),
        opacity var(--dur-slow) var(--ease-out);
    }

    .cap__stage[data-stacked] .card[data-pos="active"] {
      z-index: 3;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    .cap__stage[data-stacked] .card[data-pos="prev"],
    .cap__stage[data-stacked] .card[data-pos="next"] {
      z-index: 1;
      opacity: 0.45;
    }

    .cap__stage[data-stacked] .card[data-pos="prev"] {
      transform: translateX(var(--peek-neg)) scale(var(--peek-scale));
    }

    .cap__stage[data-stacked] .card[data-pos="next"] {
      transform: translateX(var(--peek)) scale(var(--peek-scale));
    }

    /* Reduced motion drops the falloff outright, not just its transition: the
       neighbours keep their offsets so the three-up composition is intact, but
       they are neither shrunk nor dimmed. Same size and full opacity means
       z-order alone separates them, which is quieter and more legible than a
       0.45 ghost. Auto-advance never starts (handled in deck.ts). */
    @media (prefers-reduced-motion: reduce) {
      .cap__stage[data-stacked] .card[data-pos="prev"],
      .cap__stage[data-stacked] .card[data-pos="next"] {
        opacity: 1;
      }

      .cap__stage[data-stacked] .card[data-pos="prev"] {
        transform: translateX(var(--peek-neg));
      }

      .cap__stage[data-stacked] .card[data-pos="next"] {
        transform: translateX(var(--peek));
      }
    }

    /* --- card -------------------------------------------------------------- */

    .card {
      --card-w: 84vw;
      /* Tuned by measurement, not taken on trust. The revision names both a
         58%/52% translate and a "roughly 40% of each visible" goal, and those
         two do not agree: 58% put 59% of the peeking card past the active
         card's edge, which competes with it. These values hit the stated goal —
         measured 40% at 1440 and 41% at 375. */
      --peek: 42%;
      --peek-neg: -42%;
      --peek-scale: 0.82;
      display: grid;
      grid-template-rows: auto 1fr auto auto auto;
      gap: var(--space-4);
      flex: none;
      inline-size: var(--card-w);
      block-size: 500px;
      padding: var(--space-5);
      /* Every card is ink. The deck sits on a paper section, so this is six
         dark objects on a light ground rather than paper cards on paper.
         Republishing the ground tokens locally is what lets everything inside —
         the eyebrow rule, muted body copy, fragment borders — pick up ink
         values without any component branching on where it happens to be. */
      border: var(--border-ink);
      border-radius: var(--r-md);
      background-color: var(--ink-700);
      color: var(--on-ink);
      --muted: var(--on-ink-muted);
      --hairline: var(--hairline-ink);
      --border-current: var(--border-ink);
      scroll-snap-align: start;
      transition:
        background-color var(--dur-base) var(--ease-out),
        transform var(--dur-base) var(--ease-out);
    }


    .card__index {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      color: var(--muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
    }

    .card__index::after {
      content: "";
      flex: 1;
      block-size: 1px;
      background-color: var(--hairline);
    }

    .card__fragment {
      display: grid;
      min-block-size: 0;
    }

    .card__title {
      text-wrap: balance;
    }

    .card__body {
      max-inline-size: 38ch;
      color: var(--muted);
      font-size: var(--fs-small);
      line-height: var(--lh-small);
      /* Capped so the fragment absorbs the difference and the track never
         reflows mid-drag. */
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }

    .card__tag {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
    }

    /* --laterite measures 2.79:1 on --ink-700 — under the 3:1 a graphic needs,
       let alone text. On ink the accent job goes to the link blue, which is
       verified at 6.2:1. */
    .card__tag :global(.card__icon) {
      color: var(--kai-400);
    }

    /* --- fragments --------------------------------------------------------- */

    .frag {
      display: grid;
      align-content: start;
      gap: var(--space-2);
      block-size: 100%;
      min-block-size: 0;
      padding: var(--space-3);
      border: var(--border-ink);
      border-radius: var(--r-sm);
      /* One value below the card, the way dark surfaces are meant to separate:
         --ink-700 card, --ink-900 fragment. No shadow — shadows on dark are
         invisible and only cost paint. */
      background-color: var(--ink-900);
      overflow: hidden;
    }

    .frag__label {
      color: var(--muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
    }

    .frag__list {
      display: grid;
      gap: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .frag__list li {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding-block: var(--space-2);
      border-block-start: 1px solid var(--hairline);
      font-size: var(--fs-small);
    }

    .frag__list li:last-child {
      border-block-end: 1px solid var(--hairline);
    }

    .frag__total {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-3);
      padding-block-start: var(--space-1);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      color: var(--muted);
    }

    .frag__total-value {
      font-size: 1rem;
      letter-spacing: var(--track-figure);
      text-transform: none;
      color: var(--on-ink);
    }


    .frag__state {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      font-size: var(--fs-label);
      white-space: nowrap;
    }

    /* --laterite is 3.48:1 on --ink-900, under the floor for 12px text. The
       alert reads from its words ("3 left", "Expiring"), which is the rule
       anyway: nothing conveyed by colour alone. */
    .frag__state--low {
      color: var(--on-ink);
    }

    /* --signal is 5.5:1 on --ink-900, so on this ground it can colour the text
       as well as the tick. (It measures only 3.05:1 on --paper, which is why
       the paper version of this had to split them.) */
    .frag__state--ok {
      color: var(--signal);
    }

    .frag__note {
      color: var(--muted);
      font-size: var(--fs-label);
    }

    .frag--figure {
      align-content: center;
      gap: var(--space-4);
    }

    .frag__big {
      font-size: clamp(1.5rem, 4.4vw, 1.875rem);
      letter-spacing: var(--track-figure);
      line-height: var(--lh-flat);
    }

    .frag__pair {
      display: flex;
      gap: var(--space-6);
      margin: 0;
    }

    .frag__pair dt {
      color: var(--muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
    }

    .frag__pair dd {
      margin: 0;
      margin-block-start: var(--space-1);
      font-size: 1rem;
    }

    .frag--chart {
      align-content: end;
      gap: var(--space-4);
    }

    .frag__bars {
      display: flex;
      align-items: end;
      gap: var(--space-2);
      block-size: 96px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .frag__bars li {
      flex: 1;
      block-size: var(--h);
      background-color: var(--hairline);
      border-radius: 1px;
    }

    /* The peak is the only bar that takes the accent — it is the answer the
       card is about, not decoration. */
    .frag__bars li:nth-child(4) {
      background-color: var(--laterite);
    }

    .frag__axis {
      display: flex;
      justify-content: space-between;
      gap: var(--space-2);
      color: var(--muted);
      font-size: var(--fs-label);
    }

    .frag--offline {
      align-content: center;
      gap: var(--space-3);
    }

    .frag__status {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--fs-small);
    }

    .frag__status--off {
      color: var(--on-ink);
    }

    .frag__status--ok {
      color: var(--signal);
    }

    .frag__list--queue li {
      color: var(--muted);
      /* Card 06 has the longest title and the fullest fragment; at 320px it
         was the only one still clipping. Tightening its own rows fixes it
         without making all six cards taller for one card's sake. */
      padding-block: var(--space-1);
    }

    /* --- scrub ------------------------------------------------------------- */

    .cap__scrub {
      display: flex;
      gap: 2px;
      block-size: 4px;
      margin-inline: var(--gutter);
      cursor: pointer;
      touch-action: none;
    }

    .cap__seg {
