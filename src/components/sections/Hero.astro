---
/**
 * 01 — Hero. The most important section in the build.
 *
 * One job, one second: say that this shop keeps selling when the lights go out.
 *
 * The video is the GROUND. It runs full-bleed behind the whole section at every
 * width, with the scrim over it and the type on top. There is no video "window"
 * and no column split — the type block is capped by its own measure and sits
 * left, so the footage stays visible to its right without being boxed.
 *
 * VIDEO — processed from the client's hero_vid.MOV, which could not be used as
 * delivered: the ConteKai logo is burned into every frame (measured at
 * x 50–205, y 50–85), English subtitles into ~90% of them (x 270–755,
 * y 424–488), and it carries an audio track. The encode, in
 * scripts/build-hero-video.sh, therefore:
 *   - crops to y 90–420, removing the bug and the caption band outright rather
 *     than hiding them behind blur
 *   - keeps only the two b-roll segments that contain lit screens
 *     (1.5–4.2s, 11.5–15.0s) and drops every talking-to-camera shot: a silent
 *     talking head is someone mouthing words
 *   - crossfades the join AND the loop point, so it cycles with no visible cut
 *   - blurs hard and grades toward night, so it reads as light and shadow in a
 *     room rather than a bright office arguing against the headline
 *   - strips audio entirely
 *
 * 5.2s, 77 KB MP4 / 30 KB WebM, no audio track. Measured peak luma 103/255,
 * which puts --on-ink text at 4.9:1 against the brightest pixel BEFORE the
 * scrim applies — the contrast is won in the grade, not by the scrim.
 *
 * See NOTES.md. A purpose-shot 9:16 clip of a real counter would still be
 * better than salvaged b-roll, and is still worth asking for.
 */
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";

interface HeroFootage {
  /** AVIF, the LCP candidate. */
  poster: string;
  /** VP9 or AV1. */
  webm: string;
  /** H.264 baseline. */
  mp4: string;
  /** Intrinsic dimensions. Required: they reserve the box, CLS budget < 0.1. */
  width: number;
  height: number;
}

/**
 * Return null to drop back to a plain --ink-900 ground. Nothing else needs to
 * change: the background layer, the scrim and the play control all render only
 * when footage exists, and the composition is built to stand without them.
 */
function heroFootage(): HeroFootage | null {
  return {
    poster: "/media/poster.avif",
    webm: "/media/hero.webm",
    mp4: "/media/hero.mp4",
    width: 1024,
    height: 330,
  };
}

const footage = heroFootage();
---

<section
  class:list={["hero", footage && "hero--has-video"]}
  id="top"
  data-section="hero"
  data-ground="dark"
  aria-labelledby="hero-title"
>
  {
    footage && (
      <div class="hero__bg" aria-hidden="true">
        <video
          class="hero__video"
          data-hero-video
          data-webm={footage.webm}
          data-mp4={footage.mp4}
          poster={footage.poster}
          width={footage.width}
          height={footage.height}
          preload="none"
          muted
          loop
          playsinline
          disablepictureinpicture
        />
        {/* The one permitted gradient in the build. */}
        <div class="hero__scrim" data-hero-scrim />
      </div>
    )
  }

  <div class="hero__type">
    <div class="mask">
      <Eyebrow index="01" class="hero__eyebrow">Works offline</Eyebrow>
    </div>

    {/*
      One <h1> containing all three lines. The breaks are authored rather than
      left to the browser, and each line still reflows on its own below 400px.
      The mask wrappers carry no aria attributes and there is no per-character
      splitting, so the accessible name stays one sentence.
    */}
    <h1 id="hero-title" class="hero__title">
      <span class="mask"><span class="hero__line">Keep selling</span></span>
      <span class="mask"><span class="hero__line">when the lights</span></span>
      <span class="mask"><span class="hero__line">go out.</span></span>
    </h1>

    <p class="hero__sub t-body-lg">
      Point of sale and stock control for shops in The Gambia. Every sale,
      every item, every dalasi, online or off.
    </p>

    <div class="hero__actions">
      {/* Same label as the header CTA. That repetition is correct. */}
      <Button variant="primary" href="/signup">Start 7 days free</Button>
      <Button variant="quiet" href="#pricing" icon="arrow-right">
        See pricing
      </Button>
    </div>

    <p class="hero__trust t-small">
      No card needed. Pay with Wave when you're ready.
    </p>
  </div>

  {
    footage && (
      /*
        Reduced-motion path: the poster stands and playback is offered
        explicitly. Hidden by default; hero-video.ts reveals it when autoplay
        is withheld.
      */
      <button type="button" class="hero__play" data-hero-play hidden>
        <Icon name="play" size={20} />
        <span>Play video, 5 seconds, no sound</span>
      </button>
    )
  }
</section>

{/*
  ~0.4 KB gzipped. No-ops when there is no video in the ground.
*/}
<script>
  import "../../scripts/hero-video.ts";
</script>

<style>
  @layer sections {
    /*
      min-height and padding-block come from base.css. Nothing here sets either.
    */
    .hero {
      position: relative;
      overflow: clip;
      align-items: center;
    }

    /* --- the ground -------------------------------------------------------- */

    .hero__bg {
      position: absolute;
      /* Escapes the section's own gutter so the video reaches every edge. */
      inset: 0;
      z-index: 0;
    }

    .hero__video {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
      object-position: 50% 50%;
    }

    .hero__scrim {
      position: absolute;
      inset: 0;
      /* Vertical by default: on a phone the video is the whole ground and the
         type runs down the middle of it. */
      background: var(--scrim-hero-mobile);
    }

    @media (min-width: 1024px) {
      .hero__scrim {
        /* Wide enough for the type to sit left of the footage, so the scrim
           runs across instead of down: solid behind the words, opening up on
           the right where the shop shows through. */
        background: var(--scrim-hero);
      }
    }

    /* --- type -------------------------------------------------------------- */

    .hero__type {
      position: relative;
      z-index: 1;
      display: grid;
      gap: var(--space-5);
      /* No justify-items: start — it sizes children to max-content, which stops
         the headline wrapping and scrolls the page sideways at 375px.
         The measure is what caps this block, not a column span. */
      min-inline-size: 0;
      inline-size: 100%;
      max-inline-size: 50rem;
    }

    .hero__title {
      /* Authored line breaks; balance would fight them. */
      text-wrap: initial;
    }

    .hero__line {
      display: block;
    }

    .hero__sub {
      max-inline-size: 46ch;
      color: var(--muted);
    }

    .hero__actions {
      display: grid;
      gap: var(--space-3);
      inline-size: 100%;
      margin-block-start: var(--space-2);
    }

    /* The primary takes the full width on a phone: it is the one action that
       matters and it should be a large, unmissable tap target. The quiet action
       stays a text action and sits left under it — stretching a text link
       across the screen makes it read as a second button of equal weight,
       which is exactly what "one primary per viewport" forbids. */
    .hero__actions :global(.btn--quiet) {
      justify-self: start;
    }

    .hero__trust {
      color: var(--muted);
    }

    @media (min-width: 480px) {
      .hero__actions {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        inline-size: auto;
      }
    }

    /* --- the play control (reduced motion only) ---------------------------- */

    .hero__play {
      position: absolute;
      z-index: 2;
      inset-block-end: var(--space-5);
      inset-inline-end: var(--gutter);
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-block-size: var(--tap-min);
      padding-inline: var(--space-4);
      border: var(--border-ink);
      border-radius: var(--r-sm);
      background-color: var(--ink-900);
      color: var(--on-ink);
      font-size: var(--fs-small);
      font-weight: var(--fw-semibold);
      cursor: pointer;
    }

    .hero__play[hidden] {
      display: none;
    }

    /* --- the hero load sequence (motion SKILL.md §2A) ---------------------- */

    /*
      Pure CSS, fired at parse. No JS, so it cannot be stranded by a failed
      module, and there is nothing to strand with JS disabled.

      0ms    scrim at full
      80ms   eyebrow   mask-reveal up, 320ms
      200ms  h1 line 1 mask-reveal up, 420ms
      260ms  h1 line 2
      320ms  h1 line 3   (the kit's table enumerates two lines; the headline
                          has three, so the 60ms stagger continues)
      340ms  sub       fade + 12px up, 380ms
      440ms  actions   fade + 12px up, 320ms
      520ms  trust     fade, 240ms
      600ms  scrim eases 1.0 -> 0.82 over 700ms — the lights coming up. Now that
             the scrim covers the whole viewport, this beat is the thesis
             performed: the shop comes up out of the dark as the words settle.
    */

    .mask {
      display: block;
      overflow: hidden;
    }

    @keyframes hero-mask-up {
      from {
        transform: translateY(110%);
      }
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }

    @keyframes hero-fade {
      from {
        opacity: 0;
      }
    }

    @keyframes hero-lights-up {
      from {
        opacity: 1;
      }
      to {
        opacity: 0.82;
      }
    }

    .hero__eyebrow,
    .hero__line,
    .hero__sub,
    .hero__actions,
    .hero__trust {
      animation-fill-mode: both;
      animation-timing-function: var(--ease-out);
    }

    .hero__eyebrow {
      animation-name: hero-mask-up;
      animation-duration: 320ms;
      animation-delay: 80ms;
    }

    .hero__line {
      animation-name: hero-mask-up;
      animation-duration: var(--dur-slow);
    }
    .hero__title .mask:nth-of-type(1) .hero__line {
      animation-delay: 200ms;
    }
    .hero__title .mask:nth-of-type(2) .hero__line {
      animation-delay: 260ms;
    }
    .hero__title .mask:nth-of-type(3) .hero__line {
      animation-delay: 320ms;
    }

    .hero__sub {
      animation-name: hero-rise;
      animation-duration: 380ms;
      animation-delay: 340ms;
    }

    .hero__actions {
      animation-name: hero-rise;
      animation-duration: 320ms;
      animation-delay: 440ms;
    }

    .hero__trust {
      animation-name: hero-fade;
      animation-duration: var(--dur-base);
      animation-delay: 520ms;
    }

    .hero__scrim {
      animation: hero-lights-up var(--dur-stage) var(--ease-out) 600ms both;
    }
  }
</style>
