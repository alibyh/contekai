---
/**
 * 01 — Hero. The most important section in the build.
 *
 * One job, one second: say that this shop keeps selling when the lights go out.
 *
 * ---------------------------------------------------------------------------
 * THE COMPOSITION: a horizon.
 * ---------------------------------------------------------------------------
 * There is no left/right split at any width. The viewport is divided
 * horizontally instead: night above, a lit counter below.
 *
 * The upper field is the room — --ink-900, the headline, the actions, nothing
 * else. The lower field is a band of --paper-hi that runs edge to edge, past
 * both gutters, with square corners and no shadow, anchored hard to the bottom
 * of the screen. It is not a card sitting on a background; it is a change of
 * material, and the line where the two meet is the only edge in the section.
 *
 * That is the thing the video was hired to do and never did: render "a shop at
 * dusk" — dark room, lit counter — as the page's own materials rather than as
 * footage of somebody else's. The night/paper opposition the whole build is
 * organised around is stated in the first screen, at full strength, in one cut.
 *
 * Built mobile-first. On a phone the band meets the bottom of the screen and
 * keeps going: measured, it lands flush at 414x896 and overhangs by 14px at
 * 390, 78px at 375 and 117px at 360. That overhang is the composition, not a
 * failure of it — a counter that runs past the edge of the frame is what tells
 * the reader there is more, which is the job the kit gave the video's bottom
 * bleed. What must stay above the fold is the connection state and the total,
 * because those are the two things the power cut moves; both do, from 360 up.
 * (At 320x700 the total falls below. 320 is the gate's no-horizontal-scroll
 * floor, not a layout target, and there is no horizontal scroll there.)
 *
 * That constraint is why the total sits ABOVE the items rather than under them
 * — see the note on the sum block below. Desktop keeps exactly the same
 * horizon and lays the sale out along it.
 *
 * ---------------------------------------------------------------------------
 * WHY THERE IS NO VIDEO
 * ---------------------------------------------------------------------------
 * Measured, the client's clip was an unreadable dark smear across 60% of the
 * frame at 1440, and at 375 the scrim swallowed it entirely — a flat dark field
 * with a 107 KB download attached. The salvage needed to use it at all (crop
 * out the burned-in logo and subtitle band, blur, regrade) had removed
 * everything that made it material rather than wallpaper. It is one command
 * from returning: scripts/build-hero-video.sh, against hero_vid.MOV, both still
 * in the repo. See public/media/README.md.
 *
 * ---------------------------------------------------------------------------
 * THE BEAT
 * ---------------------------------------------------------------------------
 * On load the hero performs a power cut once. The room above the horizon drops
 * a value, and the counter does not: it stays exactly as lit as it was, and
 * rings up one more item, the total climbing while the room sits in the dark.
 *
 * That replaces the beat the kit specified and the video took with it (§2A's
 * "+600ms scrim 1.0 -> 0.82, the lights coming up"). Same slot, opposite
 * direction — the lights go down and the counter stays lit, which is the
 * headline performed rather than asserted.
 *
 * MOTION — nothing loops. It fires once, on a timer, and settles in the offline
 * state on purpose: a lit counter with a queued sale in a dark room is the
 * single frame that says the most about this product. Afterwards the control
 * stays live so the reader can throw it by hand, which is what the motion skill
 * means by "a working instrument rather than a brochure".
 *
 * NO-JS / REDUCED MOTION — every state string ships in the markup twice and is
 * switched by CSS off one attribute on the section. The script writes no text,
 * so with JS off the counter renders complete and correct in its online state
 * and nothing is stranded. The queued line's box is reserved in every state, so
 * revealing it shifts nothing.
 *
 * THE LINE ITEMS are illustrative, and the only thing on this page that is.
 * They claim nothing about Contekai — a counter showing a sale is a depiction
 * of the product doing its job, not a statistic about the business — but the
 * vocabulary is real (Cash / Mobile money / Bank transfer and the dalasi format
 * both from CONTEXT.md §4) and the arithmetic is hand-checked. Swap for a real
 * 2x screenshot when the client supplies one; that asset is already on the open
 * list in PROGRESS.md.
 */
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";

/** A line on the counter. `late` marks the one rung up during the power cut. */
interface Line {
  item: string;
  qty: number;
  amount: number;
  late?: boolean;
}

const lines: Line[] = [
  { item: "Rice 25kg", qty: 1, amount: 1250 },
  { item: "Cooking oil 5L", qty: 2, amount: 780 },
  { item: "Sugar 1kg", qty: 4, amount: 260 },
  { item: "Bread", qty: 6, amount: 90, late: true },
];

/** `D 1,250`. The dalasi format from CONTEXT.md §1, not a locale guess. */
const dalasi = (n: number): string => `D ${n.toLocaleString("en-GB")}`;

const sum = (ls: Line[]): number => ls.reduce((t, l) => t + l.amount, 0);

/* Both totals are computed, never typed, so the two states cannot drift apart
   from the lines above them. 1250 + 780 + 260 = 2290, + 90 = 2380. */
const totalOnline = dalasi(sum(lines.filter((l) => !l.late)));
const totalOffline = dalasi(sum(lines));
---

<section
  class="hero"
  id="top"
  data-section="hero"
  data-ground="dark"
  aria-labelledby="hero-title"
>
  {/* ---- above the horizon: the room ---------------------------------- */}
  <div class="room">
    {/*
      Lights on. --ink-800 over the section's own --ink-900; the cut drops it
      to 0 and the darker ground shows through. An opacity move on a spare
      layer rather than a background-color animation, so the beat stays on the
      compositor and the motion skill's "transform and opacity only" holds.

      It covers only the room. The counter below is a sibling and is never
      touched by it — that is the entire point of the composition.
    */}
    <div class="room__dark" aria-hidden="true"></div>

    <div class="room__type">
      <div class="mask">
        <Eyebrow index="01" class="hero__eyebrow">Works offline</Eyebrow>
      </div>

      {/*
        One <h1>, three lines, authored breaks — and two sets of them, because
        the kit's break is physically impossible on a phone. Measured, "when
        the lights" renders at 7.75x its own font-size; at the mobile floor of
        2.75rem that is 341px, and a 375px screen offers 335px between the
        gutters. Six pixels short, so the browser re-broke it and orphaned
        "lights" on a line of its own.

        Below 480px the phrase breaks a word earlier. "when the / lights go
        out." is the only three-line arrangement that fits.

        Exactly one variant is ever in the accessibility tree: the other is
        display: none, which removes it from the name computation, so
        aria-labelledby still resolves to one clean sentence.
      */}
      <h1 id="hero-title" class="hero__title">
        <span class="hero__break hero__break--wide">
          <span class="mask"><span class="hero__line">Keep selling</span></span>
          <span class="mask"><span class="hero__line">when the lights</span></span>
          <span class="mask"><span class="hero__line">go out.</span></span>
        </span>
        <span class="hero__break hero__break--narrow">
          <span class="mask"><span class="hero__line">Keep selling</span></span>
          <span class="mask"><span class="hero__line">when the</span></span>
          <span class="mask"><span class="hero__line">lights go out.</span></span>
        </span>
      </h1>

      <p class="hero__sub t-body-lg">
        Point of sale and stock control for shops in The Gambia. Every sale,
        every item, every dalasi, online or off.
      </p>

      <div class="hero__actions">
        {/* Same label as the header CTA. That repetition is correct. */}
        <Button variant="primary" href="/signup">Start 7 days free</Button>
        <Button variant="quiet" href="#pricing" icon="arrow-right">
          See pricing
        </Button>
      </div>

      <p class="hero__trust t-small">
        No card needed. Pay with Wave when you're ready.
      </p>
    </div>
  </div>

  {/* ---- the horizon, and below it: the counter ------------------------ */}
  {/*
    Full bleed past both gutters, square corners, no shadow, no radius. The
    contrast of --paper-hi against --ink-900 is 18:1, so the edge where they
    meet needs no line drawn on it — the materials do it.
  */}
  <div class="counter">
    <div class="counter__inner">
      {/*
        The counter's own control strip: connection state on the left, the
        switch on the right, exactly where a control lives on a real terminal.
        Putting the toggle here rather than in a caption below costs no height
        and stops it competing with the primary CTA up in the room.
      */}
      <div class="counter__bar">
        {/*
          The dot is filled on --signal when synced and a hollow ring when not,
          and the word beside it says which — the state is never carried by
          colour alone.
        */}
        <p class="counter__conn" data-till-live>
          <span class="counter__dot" aria-hidden="true"></span>
          <span class="swap">
            <span data-when="on">Online</span>
            <span data-when="off">Offline</span>
          </span>
        </p>

        {/*
          A real control: the reader can throw the power off and on as many
          times as they like. Both labels ship in the markup so the accessible
          name follows the state without script-written text.
        */}
        <Button
          variant="secondary"
          icon="power"
          class="counter__toggle"
          data-till-toggle
        >
          <span class="swap">
            <span data-when="on">Cut the power</span>
            <span data-when="off">Bring the power back</span>
          </span>
        </Button>
      </div>

      {/*
        The running total sits directly under the control strip, ahead of the
        items, the way the amount-due display sits at the top of a real till
        rather than at the foot of a printed receipt. It is also the figure the
        power cut moves, so on a phone — where the band runs past the bottom of
        the screen — it is the one number guaranteed to be above the fold.
      */}
      <div class="counter__sum">
        <p class="counter__total">
          <span class="counter__totallabel">Total</span>
          {/*
            Both totals sit in the same grid cell, tabular, identical glyph
            count. The value changes without the box ever resizing.
          */}
          <span class="swap counter__totalvalue">
            <span data-when="on">{totalOnline}</span>
            <span data-when="off">{totalOffline}</span>
          </span>
        </p>
        <p class="counter__sync">
          <span class="swap">
            <span data-when="on">All sales synced</span>
            <span data-when="off">1 sale queued, syncs when you're back</span>
          </span>
        </p>
      </div>

      <ul class="counter__lines" role="list">
        {
          lines.map((line) => (
            <li class:list={["line", line.late && "line--late"]}>
              <span class="line__item">{line.item}</span>
              <span class="line__qty">&times;{line.qty}</span>
              <span class="line__amount">{dalasi(line.amount)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

{/*
  ~0.5 KB gzipped. Flips one attribute on a timer, once, then wires the
  toggle. Every visual consequence of that attribute is CSS.
*/}
<script>
  import "../../scripts/hero-power.ts";
</script>

<style>
  @layer sections {
    /*
      min-height and padding come from base.css, including the deliberate 0
      bottom padding that lets the counter reach the viewport edge.
    */
    .hero {
      position: relative;
      overflow: clip;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-7);
    }

    /* --- above the horizon ------------------------------------------------- */

    .room {
      position: relative;
      display: flex;
      align-items: center;
      flex: 1;
      min-inline-size: 0;
    }

    /* Lights on. The cut drops this to 0 and --ink-900 shows through: the one
       step down the design system sanctions between dark surfaces (value,
       never shadow, never a glow). It stops at the horizon. */
    .room__dark {
      position: absolute;
      /* Escapes the section's gutter so the room darkens edge to edge. */
      inset: calc(-1 * var(--space-6)) calc(-1 * var(--gutter));
      z-index: 0;
      background-color: var(--ink-800);
      transition: opacity var(--dur-stage) var(--ease-out);
    }

    .hero[data-power="off"] .room__dark {
      opacity: 0;
    }

    .room__type {
      position: relative;
      z-index: 1;
      display: grid;
      gap: var(--space-4);
      /* No justify-items: start — it sizes children to max-content, which stops
         the headline wrapping and scrolls the page sideways at 375px. */
      min-inline-size: 0;
      inline-size: 100%;
    }

    .hero__title {
      /* Authored line breaks; balance would fight them. */
      text-wrap: initial;
    }

    .hero__line {
      display: block;
    }

    /* display: none, not visibility — the hidden variant must leave the
       accessibility tree or the headline is announced twice. */
    .hero__break {
      display: block;
    }

    .hero__break--wide {
      display: none;
    }

    .hero__sub {
      max-inline-size: 46ch;
      color: var(--muted);
    }

    .hero__actions {
      display: grid;
      gap: var(--space-3);
      inline-size: 100%;
      margin-block-start: var(--space-2);
    }

    /* The primary takes the full width on a phone: it is the one action that
       matters and it should be a large, unmissable tap target. The quiet action
       stays a text action and sits left under it — stretching a text link
       across the screen makes it read as a second button of equal weight,
       which is exactly what "one primary per viewport" forbids. */
    .hero__actions :global(.btn--quiet) {
      justify-self: start;
    }

    .hero__trust {
      color: var(--muted);
    }

    /* --- the two-state swap ------------------------------------------------ */

    /*
      Both strings ship in the markup and CSS chooses. The hidden one is
      visibility: hidden, not opacity alone, so it leaves the accessibility
      tree and a screen reader never reads the counter twice.

      Default — no attribute at all, which is the no-JS page — is the online
      state. It is complete on its own: three lines, a correct total, synced.
    */
    .swap {
      display: inline-grid;
      min-inline-size: 0;
    }

    .swap > * {
      grid-area: 1 / 1;
      transition:
        opacity var(--dur-base) var(--ease-out),
        visibility var(--dur-base) step-end;
    }

    .swap > [data-when="off"] {
      opacity: 0;
      visibility: hidden;
    }

    .hero[data-power="off"] .swap > [data-when="on"] {
      opacity: 0;
      visibility: hidden;
    }

    .hero[data-power="off"] .swap > [data-when="off"] {
      opacity: 1;
      visibility: visible;
      transition-timing-function: var(--ease-out), step-start;
    }

    /* --- below the horizon: the counter ------------------------------------ */

    /*
      Full bleed past both gutters. Square corners, no radius, no shadow: this
      is a change of material, not a card. --paper-hi on --ink-900 measures
      18.1:1, so the horizon needs no line drawn on it.
    */
    .counter {
      position: relative;
      margin-inline: calc(-1 * var(--gutter));
      background-color: var(--paper-hi);
      color: var(--on-paper);
      /*
        This band flips material inside a dark section, so it republishes the
        four ground-dependent tokens exactly the way [data-ground="paper"] does
        in base.css. Every component inside it — the toggle's border, the muted
        text — then reads the right value without branching on the ground
        itself, which is the whole point of those neutral names.

        Republished rather than given data-ground="paper" because that would
        also force --paper as the background, and this surface is --paper-hi:
        it is the lit one.
      */
      --muted: var(--on-paper-muted);
      --faint: var(--on-paper-muted);
      --hairline: var(--hairline-paper);
      --link: var(--kai-600);
      --border-current: var(--border-paper);
    }

    .counter__inner {
      display: grid;
      gap: var(--space-4);
      padding: var(--space-3) var(--gutter) var(--space-5);
    }

    /* --- counter: the control strip ---------------------------------------- */

    .counter__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-block-end: var(--space-3);
      border-block-end: var(--border-paper);
    }

    .counter__conn {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      line-height: var(--lh-flat);
      text-transform: uppercase;
    }

    /* Sized by the longer of its two labels, so the button never resizes when
       the state flips. */
    .counter__toggle :global(.btn__label) {
      display: inline-grid;
    }

    /*
      With no JS there is nothing to throw, and a control that does nothing is
      worse than no control. The connection state still reads correctly beside
      the space it leaves.
    */
    :global(html:not([data-js])) .counter__toggle {
      display: none;
    }

    .counter__dot {
      inline-size: 8px;
      block-size: 8px;
      flex: none;
      border-radius: var(--r-full);
      /* Synced: filled. The word beside it says so too. */
      background-color: var(--signal);
      transition: background-color var(--dur-fast) var(--ease-out);
    }

    /* Not synced: the dot hollows out. Colour is never the only carrier — the
       label reads "Offline" and the sync line says what that means. */
    .hero[data-power="off"] .counter__dot {
      background-color: transparent;
      box-shadow: inset 0 0 0 1.5px var(--on-paper-muted);
    }

    .counter__sync {
      display: flex;
      margin: var(--space-2) 0 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      line-height: var(--lh-small);
      /* One line reserved. Measured: the longer variant, "1 sale queued,
         syncs when you're back", is 37 characters of DM Mono at 12px = 266px,
         and the narrowest supported viewport offers 280px between the gutters.
         Both variants fit on one line everywhere, so reserving two wasted a
         row of band height on every phone. */
      min-block-size: calc(var(--fs-label) * var(--lh-small));
    }

    /* --- counter: the sale -------------------------------------------------- */

    .counter__lines {
      display: grid;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .line {
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: baseline;
      column-gap: var(--space-4);
      font-size: var(--fs-small);
      line-height: var(--lh-small);
    }

    .line__qty,
    .line__amount {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
    }

    .line__qty {
      color: var(--muted);
    }

    .line__amount {
      min-inline-size: 5.5ch;
      text-align: end;
    }

    /*
      The line rung up during the cut. Its box is reserved in every state, so
      revealing it moves nothing: the band is the same height online, offline,
      and with JS switched off. (CLS on this page is 0 and stays 0.)
    */
    .line--late {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity var(--dur-slow) var(--ease-out),
        transform var(--dur-slow) var(--ease-out);
    }

    /* No JS, no attribute: the queued line has nothing to say, so it stays out
       of the way and the counter reads as a finished three-line sale. With the
       power cut, it arrives. */
    .hero[data-power="off"] .line--late {
      opacity: 1;
      transform: none;
    }

    /* --- counter: the total ------------------------------------------------- */

    .counter__total {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-4);
      margin: 0;
    }

    .counter__totallabel {
      font-size: var(--fs-small);
      font-weight: var(--fw-semibold);
    }

    .counter__totalvalue {
      justify-items: end;
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      font-size: var(--fs-h3);
      font-weight: var(--fw-medium);
      letter-spacing: var(--track-figure);
      line-height: var(--lh-flat);
    }

    /* --- 480: the kit's authored headline break fits from here up ----------- */

    @media (min-width: 480px) {
      .hero__break--wide {
        display: block;
      }

      .hero__break--narrow {
        display: none;
      }

      .room__type {
        gap: var(--space-5);
      }

      .hero__actions {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        inline-size: auto;
      }
    }

    /* --- 768: the sale lays out ALONG the horizon --------------------------- */

    /*
      The band keeps its full-bleed edges and its horizon; what changes is that
      the sale stops being a stack and becomes a run — status, lines, total —
      reading left to right along the counter, the way a counter is actually
      used. Still no left/right split of the SECTION; the split is inside the
      band.
    */
    @media (min-width: 768px) {
      .counter__inner {
        grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
        grid-template-areas:
          "bar   bar"
          "lines sum";
        column-gap: var(--space-7);
        align-items: start;
      }

      .counter__bar {
        grid-area: bar;
      }

      .counter__lines {
        grid-area: lines;
      }

      /* On the wide band the sale runs along the counter and the total sits at
         its end, so the DOM order (total first, for the phone's fold) is
         re-placed rather than re-written. */
      .counter__sum {
        grid-area: sum;
        border-inline-start: var(--border-paper);
        padding-inline-start: var(--space-6);
      }

      .counter__total {
        display: grid;
        justify-items: start;
        gap: var(--space-1);
      }

      .counter__totalvalue {
        justify-items: start;
      }

      /* Two lines reserved from here up. The sum column is narrower than a
         phone's measure, so the offline string wraps where the online one does
         not — without the reserve the band would change height every time the
         power was thrown. */
      .counter__sync {
        min-block-size: calc(2 * var(--fs-label) * var(--lh-small));
      }
    }

    /* --- 1024: the goods lay out ALONG the counter -------------------------- */

    /*
      A wide band is the wrong shape for a stacked list: at 1440 the three
      columns pinned themselves to opposite ends of a 900px row with nothing in
      between. So above 1024 the sale stops being a list and becomes a run —
      each item a small stack of name over quantity and amount, set side by
      side the way goods actually sit along a counter. The item rung up during
      the cut arrives at the end of the run.
    */
    @media (min-width: 1024px) {
      .counter__lines {
        display: flex;
        gap: var(--space-6);
      }

      /* Equal shares rather than flex-start: four goods spread evenly along the
         counter fill the band, where a left-packed run left half of it empty.
         It also means no wrapping to reason about — the run is always one row. */
      .line {
        flex: 1 1 0;
        min-inline-size: 0;
        grid-template-columns: auto auto;
        grid-template-areas:
          "item item"
          "qty  amount";
        justify-content: start;
        column-gap: var(--space-3);
        row-gap: var(--space-1);
      }

      .line__item {
        grid-area: item;
        font-weight: var(--fw-medium);
      }

      .line__qty {
        grid-area: qty;
      }

      .line__amount {
        grid-area: amount;
        min-inline-size: 0;
        text-align: start;
      }
    }

    @media (min-width: 1024px) {
      .counter__inner {
        padding-block: var(--space-6);
      }
    }

    /* --- the hero load sequence (motion SKILL.md §2A) ---------------------- */

    /*
      Pure CSS, fired at parse. No JS, so it cannot be stranded by a failed
      module, and there is nothing to strand with JS disabled.

      0ms    lights on, room lit, counter dark
      80ms   eyebrow    mask-reveal up, 320ms
      200ms  h1 line 1  mask-reveal up, 420ms
      260ms  h1 line 2
      320ms  h1 line 3   (the kit's table enumerates two lines; the headline
                          has three, so the 60ms stagger continues)
      340ms  sub        fade + 12px up, 380ms
      440ms  actions    fade + 12px up, 320ms
      480ms  counter    the band rises into the horizon, 420ms
      520ms  trust      fade, 240ms
      620ms  line 1     fade + 8px up, 240ms   \  rung up, 60ms apart,
      680ms  line 2                            /  three in the chain
      740ms  line 3
      840ms  control    fade, 240ms
      900ms  THE BEAT — hero-power.ts flips [data-power] to "off" once:
             the ROOM drops --ink-800 -> --ink-900 over --dur-stage while the
             counter holds its value exactly, the chip goes Offline, and a
             fourth line rings up with the total climbing behind it.

      Six elements in the longest stagger chain, 60ms apart, within the motion
      skill's ceiling. Nothing here loops.
    */

    .mask {
      display: block;
      overflow: hidden;
    }

    @keyframes hero-mask-up {
      from {
        transform: translateY(110%);
      }
    }

