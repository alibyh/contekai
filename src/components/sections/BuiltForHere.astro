---
/**
 * 03 — Built for here. Dark ground: back to night, and the section where the
 * local argument gets made explicitly.
 *
 * It answers the objection the reader is actually holding: "POS software is
 * built for shops that have power and internet. Mine doesn't, always." Benefits
 * are cheap. Conditions are credible.
 *
 * PRESENTATION: four notes pinned to the wall behind a counter. Paper cards on
 * the night ground, which strengthens the paper/night motif rather than diluting
 * it — this is the one place on the page where paper appears as objects rather
 * than as a whole section.
 *
 * The scatter is HAND-AUTHORED. Every position, width, rotation, z-index and
 * thumbtack offset below is a constant. Nothing is randomised: a scatter that
 * differs per load feels unstable on scroll-back, differs between browsers, and
 * is a well-worn generated-design tell. The asymmetry has to be a composition,
 * not a dice roll.
 *
 * Semantically this is still a description list — `<dt>` is the condition,
 * `<dd>` is the response — and the DOM order is 01 → 02 → 03 → 04 regardless of
 * where each note sits on screen. Positioning is visual only.
 */
import Eyebrow from "../ui/Eyebrow.astro";

interface Note {
  index: string;
  condition: string;
  response: string;
  /** Rotation in the scatter, and in the mobile stack. Hand-authored. */
  rotLg: number;
  rotSm: number;
  /** Thumbtack offset from centre, px. A few px each way so it reads as
      pinned by a person rather than centred by a machine. */
  tack: number;
  /** Full scatter, >= 1024. */
  lg: { x: string; y: string; w: string; z: number };
  /** Compressed two-column scatter, 900–1023: 01 + 03 left, 02 + 04 right. */
  md: { x: string; y: string; w: string };
}

/** Facts from CONTEXT.md §4 "Why Contekai", reframed as condition → response.
    The four claims are unchanged from the original §03 spec. */
const notes: Note[] = [
  {
    index: "01",
    condition: "The power goes. The network drops.",
    response:
      "Sales and stock keep working offline. Everything syncs the moment you're back online.",
    rotLg: -3,
    rotSm: -2,
    tack: -6,
    lg: { x: "3%", y: "0px", w: "300px", z: 2 },
    md: { x: "1%", y: "0px", w: "47%" },
  },
  {
    index: "02",
    condition: "Staff change often.",
    response:
      "Anyone can learn the till in a few minutes. Each person gets their own login and only the access you give them.",
    rotLg: 2,
    rotSm: 2,
    tack: 5,
    lg: { x: "52%", y: "26px", w: "280px", z: 1 },
    md: { x: "53%", y: "22px", w: "45%" },
  },
  {
    index: "03",
    condition: "Stock walks, expires, or runs out unnoticed.",
    response:
      "Alerts before you run out, before things expire, and when a count doesn't match.",
    rotLg: -1,
    rotSm: -2,
    tack: -2,
    lg: { x: "21%", y: "195px", w: "320px", z: 4 },
    md: { x: "5%", y: "150px", w: "45%" },
  },
  {
    index: "04",
    condition: "You can't see where the money is made.",
    response:
      "Best sellers, busiest hours, margin per item, profit per branch. In dalasis, daily.",
    rotLg: 4,
    rotSm: 2,
    tack: 7,
    lg: { x: "62%", y: "220px", w: "260px", z: 3 },
    md: { x: "57%", y: "200px", w: "41%" },
  },
];

/** sin(rotation), which counter-rotates each note's shadow so all four read as
    lit from the same direction. See --shadow-note in tokens.css. */
const tilt = (deg: number) => Math.sin((deg * Math.PI) / 180).toFixed(4);

const styleFor = (n: Note) =>
  [
    `--rot-lg:${n.rotLg}deg`,
    `--rot-sm:${n.rotSm}deg`,
    `--note-tilt:${tilt(n.rotLg)}`,
    `--tack:${n.tack}px`,
    `--x-lg:${n.lg.x}`,
    `--y-lg:${n.lg.y}`,
    `--w-lg:${n.lg.w}`,
    `--z:${n.lg.z}`,
    `--x-md:${n.md.x}`,
    `--y-md:${n.md.y}`,
    `--w-md:${n.md.w}`,
  ].join(";");
---

<section
  class="bfh"
  id="built-for-here"
  data-section="built-for-here"
  data-ground="dark"
  aria-labelledby="bfh-title"
>
  {/* The header is not part of the scatter. Left-aligned, top, unrotated. */}
  <div class="bfh__head">
    <Eyebrow index="03">Built for here</Eyebrow>
    <h2 id="bfh-title">Made for the way shops here actually run.</h2>
  </div>

  <dl class="board">
    {
      notes.map((note) => (
        <div class="note" style={styleFor(note)} data-reveal>
          <dt class="note__condition">
            {/* The section's one ornament. Nothing else: no tape, no staples,
                no torn edges, no paper texture. */}
            <svg
              class="note__tack"
              width="14"
              height="14"
              viewBox="0 0 14 14"
              aria-hidden="true"
            >
              <circle cx="7" cy="7" r="5" fill="var(--laterite)" />
              <circle
                cx="7"
                cy="7"
                r="5"
                fill="none"
                stroke="var(--laterite-hover)"
                stroke-width="1"
              />
            </svg>
            <span class="note__index t-mono" aria-hidden="true">
              {note.index}
            </span>
            <span class="note__text">{note.condition}</span>
          </dt>
          <dd class="note__response">{note.response}</dd>
        </div>
      ))
    }
  </dl>

  {/* Anchors the composition. Unrotated, right-aligned. */}
  <p class="bfh__stamp t-mono">The Gambia · Dalasis · Wave · Offline-first</p>
</section>

<style>
  @layer sections {
    /* Padding comes from the single [data-section] rule in base.css. This
       section has the largest padding on the page and that is the point: it
       breathes more than its neighbours. Do not add padding-block here. */
    .bfh {
      display: grid;
      gap: var(--space-8);
    }

    .bfh__head {
      display: grid;
      gap: var(--space-4);
      max-inline-size: 42rem;
    }

    .bfh__head h2 {
      max-inline-size: 22ch;
    }

    /* --- the notes ---------------------------------------------------------
       MOBILE FIRST is the stack. The scatter needs room to be asymmetric
       without clipping or squashing, so below 900px it is not attempted at all
       — notes centre, alternate a slight rotation, and sit --space-6 apart.
       ---------------------------------------------------------------------- */

    .board {
      display: grid;
      justify-items: center;
      gap: var(--space-6);
      margin: 0;
    }

    .note {
      --rot: var(--rot-sm);
      position: relative;
      inline-size: min(100%, 340px);
      padding: var(--space-5);
      border-radius: var(--r-sm);
      /* Paper objects on the night ground. */
      background-color: var(--paper);
      color: var(--on-paper);
      /* --shadow-lift's geometry, with the x-offset counter-rotated per note.
         box-shadow rotates with its element, so four rotated notes would
         otherwise read as lit from four different directions; --note-tilt is
         sin(rotation) and cancels that, holding one light source across the
         board. Composed here rather than as a whole token because a var()
         inside a :root token resolves at :root, where --note-tilt is unset. */
      box-shadow:
        calc(2px * var(--note-tilt, 0)) 2px 4px var(--shadow-ink-near),
        calc(16px * var(--note-tilt, 0)) 16px 40px -20px var(--shadow-ink-far);
      transform: rotate(var(--rot));
    }

    .note__condition {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      font-size: 1.125rem;
      font-weight: var(--fw-semibold);
      line-height: 1.25;
      text-wrap: balance;
    }

    .note__index {
      flex: none;
      color: var(--on-paper-muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      font-variant-numeric: tabular-nums;
    }

    .note__tack {
      position: absolute;
      inset-block-start: calc(var(--space-3) * -1);
      inset-inline-start: 50%;
      /* The hand-authored offset is what stops four tacks landing on one
         invisible centre line. */
      margin-inline-start: calc(-7px + var(--tack));
    }

    .note__response {
      margin: 0;
      margin-block-start: var(--space-4);
      padding-block-start: var(--space-4);
      border-block-start: var(--border-paper);
      color: var(--on-paper-muted);
      font-size: 0.9375rem;
      line-height: var(--lh-body);
    }

    /* --- the stamp --------------------------------------------------------- */

    .bfh__stamp {
      /* The section spec asks for --on-ink-faint. Measured, that is 4.06:1 at
         12px and fails the floor, which is a blocker. --on-ink-quiet is the
         token added for exactly this: the quietest text that still clears
         4.5:1 on ink, measured 4.9:1. Keeps the whisper, passes the gate. */
      color: var(--on-ink-quiet);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      text-align: end;
      text-transform: uppercase;
    }

    /* --- 900–1023: compressed two-column scatter --------------------------- */

    @media (min-width: 900px) {
      .board {
        display: block;
        position: relative;
        min-block-size: 420px;
      }

      .note {
        --rot: var(--rot-lg);
        position: absolute;
        inset-inline-start: var(--x-md);
        inset-block-start: var(--y-md);
        inline-size: var(--w-md);
        z-index: var(--z);
      }
    }

    /* --- >= 1024: the full scatter ----------------------------------------- */

    @media (min-width: 1024px) {
      .board {
        min-block-size: 450px;
      }

      .note {
        inset-inline-start: var(--x-lg);
        inset-block-start: var(--y-lg);
        inline-size: var(--w-lg);
      }
    }

    /* --- motion ------------------------------------------------------------
       Each note drops into place: from 24px above, unrotated and transparent,
       to its authored position and rotation. 60ms stagger, four steps, inside
       the six-item limit. transform and opacity only. Fires once via the shared
       observer; nothing re-animates on scroll-back.

       No hover state. These are pinned notes, not controls — a card that lifts
       under the cursor turns the section into a toy and implies an interaction
       that does not exist.
       ---------------------------------------------------------------------- */

    .note[data-reveal] {
      opacity: 0;
      transform: translateY(-24px) rotate(0deg);
      transition:
        opacity var(--dur-slow) var(--ease-out),
        transform var(--dur-slow) var(--ease-out);
    }

    .note[data-reveal].is-in {
      opacity: 1;
      transform: rotate(var(--rot));
    }

    .note:nth-child(1) {
      transition-delay: 0ms;
    }
    .note:nth-child(2) {
      transition-delay: calc(var(--stagger) * 1);
    }
    .note:nth-child(3) {
      transition-delay: calc(var(--stagger) * 2);
    }
    .note:nth-child(4) {
      transition-delay: calc(var(--stagger) * 3);
    }

    /* No-JS safety net: reveal.ts never runs, so `.is-in` never arrives.
       motion.css neutralises [data-reveal] generically, but this section
       overrides transform, so it needs its own landing state. */
    :global(html:not([data-js])) .note[data-reveal] {
      opacity: 1;
      transform: rotate(var(--rot));
    }
  }
</style>
