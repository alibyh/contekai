---
/**
 * 04 — Pricing. THE SIGNATURE. Paper ground, the tallest and most generous
 * section on the page. Everything else is quiet so this can be loud.
 *
 * Contekai's pricing has one genuinely unusual property: it is per location and
 * every plan has every feature. A three-column comparison table would have
 * nothing to compare, so the standard SaaS pricing table would be both ugly and
 * dishonest here. What the buyer needs to compute is: how many locations, how
 * long do I commit, what do I pay. So the section is a calculator that prints a
 * receipt — the artifact the product literally produces, hundreds of times a
 * day, answering the buyer's real question faster than a table could.
 *
 * The receipt earns its place only while it computes something real. If it ever
 * stops doing that, cut it and ship a plain, well-set pricing panel: a gimmick
 * that does not compute is worse than a table that does.
 *
 * NO INVENTED PRICES. The 6-month tier is absent because CONTEXT.md marks its
 * price [VERIFY] and it has not been confirmed — an invented number on a
 * pricing page is the most damaging possible error. The multi-location discount
 * the current site promises but never states is likewise absent, and the copy
 * does not hint at one. Both are tracked in NOTES.md.
 */
import Eyebrow from "../ui/Eyebrow.astro";
import Icon from "../ui/Icon.astro";

/**
 * Every figure here traces to CONTEXT.md §4:
 *   D 1,500 per location per month
 *   D 16,200 per location per year, listed at D 18,000, saving D 1,800
 * 18,000 → 16,200 is exactly 10%, which is the only discount stated anywhere.
 */
const terms = [
  { id: "m1", label: "1 month", months: 1, rate: 1500, discount: 0 },
  { id: "m12", label: "12 months", months: 12, rate: 1500, discount: 0.1 },
] as const;
---

<section
  class="pricing"
  id="pricing"
  data-section="pricing"
  data-ground="paper"
  aria-labelledby="pricing-title"
>
  <div class="pricing__head">
    <Eyebrow index="04">Pricing</Eyebrow>
    <h2 id="pricing-title">Pay per location. Nothing else.</h2>
    <p class="pricing__intro t-body-lg">
      Every plan has every feature. Longer terms cost less. That's the whole
      pricing page.
    </p>
  </div>

  <div class="pricing__body">
    {/* --- controls ------------------------------------------------------- */}
    <div class="controls">
      {/* Not a fourth column. Stating "your first location" plainly is a trust
          move; hiding it and surprising someone at location two is not. */}
      <p class="controls__trial">
        <strong>7 days free, on your first location.</strong> No card. Nothing to
        pay until you decide.
      </p>

      <div class="field">
        <label class="field__label" for="locations">Locations</label>
        <div class="stepper">
          <button
            type="button"
            class="stepper__btn"
            data-step="-1"
            aria-label="Fewer locations"
          >
            <Icon name="minus" size={20} />
          </button>
          {/* A real number input. Keyboard users type, touch users tap. */}
          <input
            class="stepper__input t-figure"
            type="number"
            id="locations"
            name="locations"
            min="1"
            max="99"
            step="1"
            value="1"
            inputmode="numeric"
            data-locations
          />
          <button
            type="button"
            class="stepper__btn"
            data-step="1"
            aria-label="More locations"
          >
            <Icon name="plus" size={20} />
          </button>
        </div>
        <p class="field__hint">Most shops start with one.</p>
      </div>

      <fieldset class="field">
        <legend class="field__label">Term</legend>
        <div class="segmented" role="radiogroup" aria-label="Billing term">
          {
            terms.map((term, i) => (
              <label class="segmented__option">
                <input
                  type="radio"
                  name="term"
                  value={term.id}
                  data-term
                  data-months={term.months}
                  data-rate={term.rate}
                  data-discount={term.discount}
                  checked={i === terms.length - 1}
                />
                <span class="segmented__label">{term.label}</span>
                {/* Only ever state a discount that is real: 18,000 → 16,200. */}
                {term.discount > 0 && (
                  <span class="segmented__save t-mono">
                    &minus;{Math.round(term.discount * 100)}%
                  </span>
                )}
              </label>
            ))
          }
        </div>
        <p class="field__hint">
          Every plan includes every feature. The price is the only difference.
        </p>
      </fieldset>
    </div>

    {/* --- the receipt ---------------------------------------------------- */}
    <div class="receipt" data-reveal>
      <div class="receipt__face">
        <header class="receipt__head">
          <p class="receipt__brand">Contekai</p>
          <p class="receipt__sub">POS &amp; Inventory</p>
          {/* Filled client-side; a real date is a small detail that sells the
              artifact. Empty until then rather than showing a stale build date. */}
          <p class="receipt__date" data-receipt-date></p>
        </header>

        <table class="receipt__table">
          <caption class="visually-hidden">
            Your Contekai subscription
          </caption>
          <thead>
            <tr>
              <th scope="col" class="receipt__qty">Qty</th>
              <th scope="col">Item</th>
              <th scope="col" class="receipt__amt">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr data-line="base">
              <td class="receipt__qty t-figure" data-out="qty">1</td>
              <th scope="row" class="receipt__item">
                Location &times; <span data-out="term-label">12 months</span>
              </th>
              <td class="receipt__amt t-figure" data-out="list">D 18,000</td>
            </tr>
            <tr data-line="discount" data-out="discount-row">
              <td class="receipt__qty"></td>
              <th scope="row" class="receipt__item">Annual discount</th>
              <td class="receipt__amt t-figure" data-out="discount">
                &minus;D 1,800
              </td>
            </tr>
          </tbody>
          <tfoot>
            <tr class="receipt__total">
              <td class="receipt__qty"></td>
              <th scope="row" class="receipt__item">Total due</th>
              <td class="receipt__amt t-figure" data-out="total">D 16,200</td>
            </tr>
            <tr>
              <td class="receipt__qty"></td>
              <th scope="row" class="receipt__item">Per location / month</th>
              <td class="receipt__amt t-figure" data-out="unit">D 1,350</td>
            </tr>
          </tfoot>
        </table>

        {/* The computed region, announced as one sentence rather than as five
            separate cell changes. */}
        <p class="visually-hidden" aria-live="polite" data-receipt-live></p>

        <ul class="receipt__terms t-mono">
          <li>First 7 days free</li>
          <li>Paid by Wave</li>
        </ul>

        {/* A primary button inside a paper artifact is the section's payoff. */}
        <a class="receipt__cta" href="/signup">Start 7 days free</a>
      </div>
    </div>
  </div>

  <p class="pricing__foot t-small">
    Prices in Gambian dalasi. Paid by Wave. Add or remove locations whenever you
    need to. Adding a location later is billed at the same rate from the day you
    add it.
  </p>
</section>

<script>
  import "../../scripts/pricing.ts";
</script>

<style>
  @layer sections {
    /* Padding comes from the single [data-section] rule in base.css. */
    .pricing {
      display: grid;
      gap: var(--space-8);
    }

    .pricing__head {
      display: grid;
      gap: var(--space-4);
      max-inline-size: 42rem;
    }

    .pricing__head h2 {
      max-inline-size: 18ch;
    }

    .pricing__intro {
      max-inline-size: 52ch;
      color: var(--muted);
    }

    .pricing__body {
      display: grid;
      gap: var(--space-8);
      align-items: start;
    }

    .pricing__foot {
      max-inline-size: 60ch;
      color: var(--muted);
    }

    /* --- controls ---------------------------------------------------------- */

    .controls {
      display: grid;
      gap: var(--space-6);
      max-inline-size: 32rem;
    }

    .controls__trial {
      padding-block-end: var(--space-5);
      border-block-end: var(--border-paper);
      max-inline-size: 42ch;
    }

    .field {
      display: grid;
      gap: var(--space-3);
      margin: 0;
      padding: 0;
      border: 0;
    }

    .field__label {
      padding: 0;
      color: var(--on-paper);
      font-size: var(--fs-small);
      font-weight: var(--fw-semibold);
    }

    .field__hint {
      color: var(--muted);
      font-size: var(--fs-small);
      max-inline-size: 34ch;
    }

    /* --- stepper ----------------------------------------------------------- */

    .stepper {
      display: flex;
      align-items: stretch;
      gap: var(--space-2);
      inline-size: fit-content;
    }

    .stepper__btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: var(--tap-min);
      block-size: var(--tap-min);
      padding: 0;
      border: var(--border-paper);
      border-radius: var(--r-sm);
      background-color: var(--paper-hi);
      color: inherit;
      cursor: pointer;
      transition: border-color var(--dur-fast) var(--ease-out);
    }

    .stepper__btn:hover {
      border-color: currentColor;
    }

    .stepper__btn[aria-disabled="true"] {
      opacity: 0.4;
      cursor: default;
    }

    .stepper__input {
      inline-size: 5rem;
      padding-inline: var(--space-3);
      border: var(--border-paper);
      border-radius: var(--r-sm);
      background-color: var(--paper-hi);
      color: var(--on-paper);
      font-size: 1.25rem;
      text-align: center;
    }

    /* The spinners duplicate the +/- buttons and shrink the tap target. */
    .stepper__input::-webkit-outer-spin-button,
    .stepper__input::-webkit-inner-spin-button {
      appearance: none;
      margin: 0;
    }

    .stepper__input[type="number"] {
      appearance: textfield;
    }

    /* --- segmented term control -------------------------------------------- */

    .segmented {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .segmented__option {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-block-size: var(--tap-min);
      padding-inline: var(--space-4);
      border: var(--border-paper);
      border-radius: var(--r-sm);
      background-color: var(--paper-hi);
      cursor: pointer;
      transition:
        border-color var(--dur-fast) var(--ease-out),
        background-color var(--dur-fast) var(--ease-out);
    }

    /* Real radios, visually replaced but never removed: they stay in the tab
       order, arrow keys move between them, and the focus ring is theirs. */
    .segmented__option input {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .segmented__option:has(input:checked) {
      border-color: var(--on-paper);
      background-color: var(--paper);
    }

    .segmented__option:has(input:focus-visible) {
      outline: var(--focus-ring);
      outline-offset: var(--focus-offset);
    }

    .segmented__label {
      font-weight: var(--fw-medium);
    }

    .segmented__save {
      color: var(--laterite);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
    }

    /* --- the receipt -------------------------------------------------------
       Zero radius, torn top and bottom, --paper-hi face, DM Mono throughout.
       No border: the torn edges define it.
       ---------------------------------------------------------------------- */

    .receipt {
      --tear: 12px;
      inline-size: 100%;
      max-inline-size: 420px;
      /* The one element on the page permitted to centre, because a receipt is
         symmetric. */
      margin-inline: auto;
      filter: var(--shadow-lift-drop);
    }

    .receipt__face {
      padding: var(--space-6) var(--space-5);
      background-color: var(--paper-hi);
      border-radius: var(--r-none);
      font-family: var(--font-mono);
      font-size: var(--fs-receipt);
      letter-spacing: var(--track-receipt);
      line-height: var(--lh-receipt);
      font-variant-numeric: tabular-nums;
      /* Scalloped top and bottom. Two radial gradients tiled across the width;
         `transparent 99%` keeps the arc crisp — a soft edge reads as a
         drop-shadow bug rather than a tear. */
      mask-image:
        radial-gradient(
          var(--tear) at 50% 0,
          transparent 99%,
          var(--mask-opaque) 100%
        ),
        radial-gradient(
          var(--tear) at 50% 100%,
          transparent 99%,
          var(--mask-opaque) 100%
        );
      mask-size: calc(var(--tear) * 2) 100%;
      mask-repeat: repeat-x;
      mask-composite: intersect;
    }

    .receipt__head {
      text-align: center;
      padding-block-end: var(--space-4);
    }

    .receipt__brand {
      font-size: 1rem;
      font-weight: var(--fw-medium);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
    }

    .receipt__sub,
    .receipt__date {
      color: var(--muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
    }

    .receipt__table {
      inline-size: 100%;
      border-collapse: collapse;
      text-align: start;
    }

    .receipt__table th,
    .receipt__table td {
      padding-block: var(--space-1);
      font-weight: var(--fw-regular);
      vertical-align: baseline;
    }

    .receipt__table thead th {
      color: var(--muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      border-block-end: 1px dashed var(--hairline-paper);
    }

    .receipt__qty {
      inline-size: 3ch;
      text-align: start;
    }

    .receipt__amt {
      text-align: end;
      white-space: nowrap;
    }

    .receipt__item {
      text-align: start;
      /* The dotted leader is what makes this read as a printed docket rather
         than a styled div. */
      position: relative;
      padding-inline-end: var(--space-3);
    }

    tbody .receipt__item::after,
    tfoot .receipt__item::after {
      content: "";
      position: absolute;
      inset-block-end: 0.36em;
      inset-inline: 0.4em var(--space-2);
      border-block-end: 1px dotted var(--hairline-paper);
      z-index: -1;
    }

    /* The changed line flashes once; the total never does — it just changes. */
    .receipt__table tr {
      background-color: transparent;
    }

    .receipt__table tr.is-changed {
      animation: receipt-flash var(--dur-slow) var(--ease-out) 1;
    }

    @keyframes receipt-flash {
      from {
        background-color: var(--flash-laterite);
      }
      to {
        background-color: transparent;
      }
    }

    tfoot {
      border-block-start: 3px double var(--hairline-paper);
    }

    .receipt__total th,
    .receipt__total td {
      padding-block-start: var(--space-3);
      font-size: 1.25rem;
      font-weight: var(--fw-medium);
      text-transform: uppercase;
      letter-spacing: var(--track-label);
    }

    .receipt__total .receipt__amt {
      letter-spacing: var(--track-figure);
    }

    .receipt__terms {
      display: grid;
      gap: var(--space-1);
      margin-block-start: var(--space-5);
      padding-block-start: var(--space-4);
      border-block-start: 1px dashed var(--hairline-paper);
      color: var(--muted);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
      list-style: none;
      padding-inline: 0;
    }

    .receipt__cta {
      display: flex;
      align-items: center;
      justify-content: center;
      min-block-size: var(--btn-h);
      margin-block-start: var(--space-5);
      border-radius: var(--r-sm);
      background-color: var(--laterite);
      color: var(--on-laterite);
      font-family: var(--font-sans);
      font-size: var(--fs-body);
      font-weight: var(--fw-semibold);
      text-decoration: none;
      transition: background-color var(--dur-fast) var(--ease-out);
    }

    .receipt__cta:hover {
      background-color: var(--laterite-hover);
    }

    /* --- motion ------------------------------------------------------------
       The receipt clips in from the top, as if fed out of a printer. This is
       the section's entrance and it fires once.

       The clip is on the FACE, not on .receipt, even though .receipt is what
       carries [data-reveal]. Chrome's IntersectionObserver applies a target's
       own clip-path when computing intersection, so putting the print clip on
       the observed element makes it report a ratio of 0 forever: it never
       fires, so it never unclips, so it never fires. Measured 0 vs 0.67 with
       the clip removed. The wrapper is observed; the child is clipped.
       ---------------------------------------------------------------------- */

    .receipt[data-reveal] {
      opacity: 1;
      transform: none;
      clip-path: none;
    }

    .receipt__face {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
      transition:
        opacity var(--dur-slow) var(--ease-out),
        clip-path var(--dur-slow) var(--ease-out);
    }

    .receipt.is-in .receipt__face {
      opacity: 1;
      clip-path: inset(0);
    }

    :global(html:not([data-js])) .receipt__face {
      opacity: 1;
      clip-path: none;
    }

    /* --- responsive --------------------------------------------------------- */

    @media (min-width: 768px) {
      .pricing__body {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: var(--space-5);
      }

      .controls {
        grid-column: 1 / span 5;
      }

      .receipt {
        grid-column: 7 / -1;
        /* Offset upward so it does not share a baseline with the controls. */
        margin-block-start: calc(var(--space-6) * -1);
      }
    }

    /* Narrow phones. The spec calls for 0.75rem mono and a 9px tear here, and
       measured at 320px that keeps every FIGURE on one line — but the item
       labels still wrapped ("Annual / discount") and TOTAL DUE broke in two,
       which reads as a broken docket rather than a tight one. Buying back
       16px of measure from the face padding and dropping the total a step
       fixes both without touching the copy. */
    @media (max-width: 379.98px) {
      .receipt {
        --tear: 9px;
      }

      .receipt__face {
        padding: var(--space-5) var(--space-4);
        font-size: 0.75rem;
      }

      .receipt__qty {
        inline-size: 2ch;
      }

      .receipt__total th,
      .receipt__total td {
        font-size: 1.0625rem;
      }
    }
  }
</style>
